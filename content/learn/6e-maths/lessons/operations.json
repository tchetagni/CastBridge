   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Division euclidienne",
     "md": "Diviser **a** par **b** (b ≠ 0), c'est trouver le quotient entier **q** et le reste **r** tels que $a = b \\times q + r$ avec $r < b$."
    },
    {
     "type": "illustration",
     "caption": "Division euclidienne de 47 par 6.",
     "alt": "Schéma de la division euclidienne de 47 par 6 : quotient 7, reste 5.",
     "figure": {
      "kind": "shapes",
      "w": 400,
      "h": 130,
      "items": [
       {
        "t": "rect",
        "x": 20,
        "y": 40,
        "w": 360,
        "h": 50,
        "fill": "lightyellow",
        "stroke": "ink",
        "width": 2
       },
       {
        "t": "line",
        "x1": 220,
        "y1": 40,
        "x2": 220,
        "y2": 90,
        "color": "ink",
        "width": 2
       },
       {
        "t": "text",
        "x": 120,
        "y": 72,
        "text": "a = 47",
        "size": 22,
        "color": "ink",
        "anchor": "middle",
        "bold": true
       },
       {
        "t": "text",
        "x": 300,
        "y": 72,
        "text": "b = 6",
        "size": 22,
        "color": "ink",
        "anchor": "middle",
        "bold": true
       },
       {
        "t": "text",
        "x": 120,
        "y": 110,
        "text": "47 = 6 × 7 + 5",
        "size": 18,
        "color": "blue",
        "anchor": "middle",
        "bold": true
       },
       {
        "t": "text",
        "x": 300,
        "y": 25,
        "text": "q = 7 ; r = 5",
        "size": 16,
        "color": "red",
        "anchor": "middle"
       }
      ]
     }
    },
    {
     "type": "key",
     "style": "retenir",
     "title": "Priorités des opérations",
     "md": "1. On calcule d'abord ce qui est entre **parenthèses**.\n2. Puis les **multiplications et divisions**, de gauche à droite.\n3. Enfin les **additions et soustractions**, de gauche à droite."
    },
    {
     "type": "example",
     "title": "Exemple 1 : division euclidienne",
     "statement": "Effectue la division euclidienne de 259 par 12.",
     "steps": [
      {
       "md": "12 × 20 = 240, il reste 259 − 240 = 19. 12 × 1 = 12, il reste 19 − 12 = 7."
      },
      {
       "md": "Le quotient est 20 + 1 = 21 et le reste 7 :",
       "tex": "259 = 12 \\times 21 + 7"
      }
     ],
     "answer": "**q = 21 et r = 7**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : priorités",
     "statement": "Calcule A = 5 + 3 × 4 et B = (5 + 3) × 4.",
     "steps": [
      {
       "md": "Dans A, la multiplication passe d'abord : 3 × 4 = 12, puis 5 + 12 = 17."
      },
      {
       "md": "Dans B, on calcule la parenthèse : 5 + 3 = 8, puis 8 × 4 = 32."
      }
     ],
     "answer": "**A = 17 et B = 32**"
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Erreurs fréquentes",
     "md": "- Calculer de gauche à droite sans respecter les priorités : 5 + 3 × 4 n'est pas 32.\n- Un reste supérieur ou égal au diviseur : si r ≥ b, le quotient est trop petit.\n- Oublier de vérifier avec $b \\times q + r = a$."
    }
   ],
   "reviewNotes": [
    "Vérifier si la distributivité est introduite en 6e ou seulement en 5e."
   ]
  },
