     "steps": [
      {
       "md": "On applique la formule :",
       "tex": "P = 2 \\times 3{,}14 \\times 5"
      },
      {
       "md": "2 × 3,14 = 6,28 ; 6,28 × 5 = 31,4."
      }
     ],
     "answer": "**P ≈ 31,4 cm**"
    },
