    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- Thinking −9 is larger than −2: on the number line −9 is further left.\n- Writing 3 − (−8) = −5; two minus signs together make a plus: 3 + 8 = 11.\n- Applying the 'two negatives make a positive' rule to addition: −3 + (−4) = −7."
    },
    {
     "type": "example",
     "title": "Example 1: add and subtract",
     "statement": "Calculate (a) −7 + 12, (b) −3 − 4, (c) 3 − (−8).",
     "steps": [
      "(a) Start at −7 and move 12 to the right: −7 + 12 = 5.",
      "(b) Start at −3 and move 4 to the left: −7.",
      "(c) Subtracting −8 is adding 8: 3 + 8 = 11."
     ],
     "answer": "**(a) 5, (b) −7, (c) 11**"
    },
    {
     "type": "example",
     "title": "Example 2: multiply and divide",
     "statement": "Calculate (a) (−6) × (−4), (b) 20 ÷ (−5), (c) (−2) × 3 × (−5).",
     "steps": [
      "(a) Same signs, positive: 6 × 4 = 24.",
      "(b) Different signs, negative: 20 ÷ 5 = 4, so −4.",
      "(c) (−2) × 3 = −6, then (−6) × (−5) = 30."
     ],
     "answer": "**(a) 24, (b) −4, (c) 30**"
    }
