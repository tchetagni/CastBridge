   "id": "form1-maths-whole-numbers",
   "title": "Whole numbers, order of operations and rounding",
   "minutes": 25,
   "programRef": "Cameroon secondary (general education) Mathematics programme, Form 1 (MINESEC) — to be checked against the official programme",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Read and write whole numbers using place value",
    "Use the order of operations (BODMAS)",
    "Round numbers to the nearest 10, 100 or 1 000",
    "Estimate an answer before calculating"
