   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Factors, multiples and primes",
     "md": "A **factor** of a number divides it exactly: the factors of 12 are 1, 2, 3, 4, 6, 12. A **multiple** of 12 is in its times table: 12, 24, 36… A **prime number** has exactly two factors, 1 and itself (2, 3, 5, 7, 11, 13…). The number 1 is not prime."
    },
    {
     "type": "key",
     "style": "retenir",
     "title": "Divisibility tests",
     "md": "- by 2: the last digit is even;\n- by 3: the sum of the digits is divisible by 3;\n- by 5: the last digit is 0 or 5;\n- by 9: the sum of the digits is divisible by 9;\n- by 10: the last digit is 0."
    },
