    {
     "type": "key",
     "style": "retenir",
     "title": "Quand le chiffre du haut est trop petit",
     "md": "On **emprunte** une dizaine : 4 − 7 est impossible, donc on calcule **14 − 7 = 7**, puis on ajoute **1** au chiffre du bas dans la colonne suivante (la retenue)."
    },
    {
     "type": "example",
     "title": "Exemple 1 : sans retenue",
     "statement": "Calcule 586 − 243.",
     "steps": [
      {
       "md": "Unités : 6 − 3 = 3."
      },
      {
       "md": "Dizaines : 8 − 4 = 4."
      },
      {
       "md": "Centaines : 5 − 2 = 3."
      }
     ],
     "answer": "**586 − 243 = 343**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : avec retenue",
     "statement": "Calcule 584 − 237.",
     "steps": [
      {
       "md": "Unités : 4 − 7 impossible → 14 − 7 = 7. Je retiens 1."
      },
      {
       "md": "Dizaines : 8 − (3 + 1) = 4."
      },
      {
       "md": "Centaines : 5 − 2 = 3."
      }
     ],
     "answer": "**584 − 237 = 347**"
    },
    {
     "type": "exercise",
     "ref": "ce1-maths-soustraction-posee-01"
    },
    {
     "type": "key",
     "style": "methode",
     "title": "Je vérifie avec l'addition",
     "md": "347 + 237 = 584 ✓ : le résultat plus le petit nombre redonne le grand nombre."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Attention",
     "md": "- On ne soustrait jamais le petit chiffre du grand dans l'autre sens : 4 − 7 n'est pas 3.\n- Je n'oublie pas la retenue au chiffre du bas."
    }
   ]
