    {
     "type": "example",
     "title": "Exemple 1 : groupes égaux",
     "statement": "Chaque panier contient 5 plantains. Il y a 6 paniers. Combien de plantains ?",
     "steps": [
      {
       "md": "6 groupes de 5 : multiplication."
      },
      {
       "md": "6 × 5 = 30."
      }
     ],
     "answer": "**30 plantains**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : partage",
     "statement": "Maman partage 18 arachides entre 3 enfants. Combien chacun en a-t-il ?",
     "steps": [
      {
       "md": "Je cherche : 3 fois combien font 18 ?"
      },
      {
       "md": "3 × 6 = 18."
      }
     ],
     "answer": "**Chaque enfant a 6 arachides.**"
    },
