    {
     "type": "example",
     "title": "Exemple 1 : additionner des prix",
     "statement": "Marie achète un cahier à 300 FCFA et un stylo à 150 FCFA. Combien paie-t-elle ?",
     "steps": [
      {
       "md": "Je fais une addition : 300 + 150."
      },
      {
       "md": "300 + 150 = 450."
      }
     ],
     "answer": "**450 FCFA**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : rendre la monnaie",
     "statement": "Paul donne un billet de 1 000 FCFA pour un objet à 650 FCFA. Quelle monnaie lui rend-on ?",
     "steps": [
      {
       "md": "Je fais une soustraction : 1 000 − 650."
      },
      {
       "md": "1 000 − 650 = 350."
      }
     ],
     "answer": "**350 FCFA**"
