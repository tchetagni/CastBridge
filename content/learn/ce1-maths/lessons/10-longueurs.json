    {
     "type": "example",
     "title": "Exemple 1 : lire une mesure",
     "statement": "Un crayon commence à 0 sur la règle et finit à 14. Quelle est sa longueur ?",
     "steps": [
      {
       "md": "Je place le début du crayon sur le 0."
      },
      {
       "md": "Je lis le nombre où il finit : 14."
      }
     ],
     "answer": "**Le crayon mesure 14 cm.**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : convertir",
     "statement": "Combien de centimètres font 3 m ?",
     "steps": [
      {
       "md": "1 m = 100 cm."
      },
      {
       "md": "3 m = 100 + 100 + 100 = 300 cm."
      }
     ],
     "answer": "**3 m = 300 cm**"
    },
    {
     "type": "exercise",
     "ref": "ce1-maths-longueurs-01"
    },
    {
     "type": "key",
     "style": "methode",
     "title": "Méthode",
     "md": "1. Je pose la règle avec le **0** au bout du segment.\n2. Je lis le nombre à l'autre bout.\n3. J'écris l'unité (cm).\n\nPour comparer, j'écris les deux longueurs avec la même unité."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Attention",
     "md": "- Ne commence pas à 1 : commence au 0.\n- Compare seulement des longueurs qui ont la **même unité** : 1 m est plus grand que 90 cm."
    }
   ]
  }
