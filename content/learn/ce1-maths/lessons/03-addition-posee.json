      {
       "md": "Unités : 4 + 3 = 7."
      },
      {
       "md": "Dizaines : 1 + 2 = 3."
      },
      {
       "md": "Centaines : 2 + 1 = 3."
      }
     ],
     "answer": "**214 + 123 = 337**"
    },
