     "steps": [
      {
       "md": "Sous la caisse, il n'y a **pas de lumière**."
      },
      {
       "md": "Sans arrosage, il n'a pas d'**eau**."
      }
     ],
     "answer": "**Il manque de lumière et d'eau.**"
    },
