    {
     "type": "example",
     "title": "Exemple 1 : mustn't ou don't have to ?",
     "statement": "Complète : Tomorrow is Sunday. We ____ go to school.",
     "steps": [
      {
       "md": "Dimanche, ce n'est pas obligatoire d'aller à l'école : absence d'obligation."
      },
      {
       "md": "On emploie don't have to (pas mustn't, qui signifie « c'est interdit »)."
      }
     ],
     "answer": "**We don't have to go to school.**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : conseil",
     "statement": "Amina has a bad cough. Donne-lui un conseil.",
     "steps": [
      {
       "md": "Pour un conseil, on utilise should + verbe de base."
      },
      {
       "md": "On relit la phrase obtenue pour vérifier la forme du verbe et le sens."
      }
     ],
     "answer": "**You should see a doctor.**"
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Erreurs fréquentes",
     "md": "- « He cans swim » / « He can swims » : jamais de -s ni de to après can.\n- « Do you can swim ? » : on dit « Can you swim ? ».\n- mustn't = interdiction ; don't have to = pas obligatoire. Ce n'est PAS la même chose."
    }
   ],
