    {
     "type": "audio",
     "lang": "fr-FR",
     "text": "Je chante, tu chantes, il chante, nous chantons, vous chantez, ils chantent."
    },
    {
     "type": "key",
     "style": "retenir",
     "title": "Les terminaisons",
     "md": "je **-e**, tu **-es**, il / elle **-e**, nous **-ons**, vous **-ez**, ils / elles **-ent**.\n\nOn enlève -er, on garde le début du verbe (chant-) et on ajoute la terminaison."
    },
    {
     "type": "example",
     "title": "Exemple 1 : conjuguer",
     "statement": "Conjugue « jouer » avec tu.",
     "steps": [
      {
       "md": "Je prends le début : jou-."
      },
      {
       "md": "Avec tu, j'ajoute **-es** : tu joues."
      }
     ],
     "answer": "Tu **joues**."
    },
    {
     "type": "example",
     "title": "Exemple 2 : ils",
     "statement": "Complète : Les enfants ___ (danser).",
     "steps": [
      {
       "md": "« Les enfants » : on peut dire ils."
      },
      {
       "md": "Avec ils, on ajoute **-ent** : dansent."
      }
     ],
     "answer": "Les enfants **dansent**."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Attention",
     "md": "Avec ils / elles, il y a **-ent** : « ils chantent ». Il ne se prononce pas, mais on l'écrit ! Avec tu, il y a toujours **-s**."
    },
