   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Magic e",
     "md": "A silent **e** at the end of a word can change the vowel sound. **cap** becomes **cape**. **pin** becomes **pine**. **hop** becomes **hope**. The vowel says its name."
    },
