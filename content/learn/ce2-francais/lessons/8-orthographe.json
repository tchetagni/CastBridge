  {
   "id": "ce2-francais-homophones",
   "title": "Les homophones : a/à, et/est, on/ont, son/sont",
   "minutes": 15,
   "readAloud": true,
   "programRef": "CE2 — Français (MINEDUB) — reconstitué, à vérifier sur le texte officiel — Orthographe grammaticale : homophones",
   "status": "draft",
   "author": "CastBridge (brouillon IA)",
   "source": "Rédaction originale ; à faire relire par un enseignant",
   "objectives": [
    "Distinguer a et à, et et est, on et ont, son et sont.",
    "Utiliser une astuce de remplacement.",
    "Corriger une erreur d'homophone."
   ],
   "prerequisites": [
    "ce2-francais-pronoms",
    "ce2-francais-present-er"
   ],
   "exercises": [
    "ce2-francais-homophones-01",
