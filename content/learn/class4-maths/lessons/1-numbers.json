   "id": "class4-maths-compare-order-round",
   "title": "Comparing, ordering and rounding numbers",
   "minutes": 25,
   "programRef": "MINEDUB primary school curriculum (English-speaking subsystem), Level II (Class 4) — Mathematics; to be checked against the official syllabus",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Compare numbers with <, > and =.",
    "Order numbers from smallest to biggest and back.",
    "Round to the nearest 10, 100 and 1,000."
   ],
   "prerequisites": [],
   "exercises": [
    "class4-maths-numbers-e07",
