     "type": "example",
     "title": "Example 2",
     "statement": "Round 6,748 to the nearest 10, 100 and 1,000.",
     "steps": [
      "Nearest ten: the units digit is 8, so go up: 6,750.",
      "Nearest hundred: the tens digit is 4, so stay: 6,700. Nearest thousand: the hundreds digit is 7, so go up: 7,000."
     ],
     "answer": "6,750; 6,700; 7,000."
