   "id": "class4-maths-perimeter-area",
   "title": "Perimeter and area of rectangles and squares",
   "minutes": 30,
   "programRef": "MINEDUB primary school curriculum (English-speaking subsystem), Level II (Class 4) — Mathematics; to be checked against the official syllabus",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Find the perimeter of a rectangle, a square and other shapes.",
    "Find the area of a rectangle and a square.",
    "Use the right units (m, m²)."
   ],
   "prerequisites": [],
   "exercises": [
    "class4-maths-geometry-e01",
    "class4-maths-geometry-e02",
    "class4-maths-geometry-e03",
    "class4-maths-geometry-e04",
    "class4-maths-geometry-e05",
    "class4-maths-geometry-e06"
   ],
   "selfCheck": [
    "class4-maths-perimeter-area-q1",
    "class4-maths-perimeter-area-q2",
    "class4-maths-perimeter-area-q3",
    "class4-maths-perimeter-area-q4",
    "class4-maths-perimeter-area-q5"
   ],
   "reviewNotes": [
    "Area of rectangle and square only; triangles and other shapes belong to later classes.",
    "Syllabus references, scope and level of difficulty are to be checked against the official text; all facts, formulas and worked examples to be verified by a teacher before release."
   ],
   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Perimeter and area",
     "md": "The **perimeter** is the **distance around** a shape: add all the sides. The **area** is the **space inside** a shape: we count square units (cm², m²). A rectangle with length $l$ and width $w$ has perimeter $2 \\times (l + w)$ and area $l \\times w$. A square with side $s$ has perimeter $4 \\times s$ and area $s \\times s$."
    },
    {
     "type": "illustration",
     "figure": {
      "kind": "shapes",
      "w": 400,
      "h": 160,
      "items": [
       {
        "t": "rect",
        "x": 60,
        "y": 30,
        "w": 200,
        "h": 100,
        "stroke": "ink",
        "width": 3,
        "fill": "lightyellow"
       },
       {
        "t": "text",
        "x": 160,
        "y": 20,
        "text": "12 m",
        "size": 14,
        "anchor": "middle",
        "color": "ink",
        "bold": true
       },
       {
        "t": "text",
        "x": 272,
        "y": 85,
        "text": "8 m",
        "size": 14,
        "anchor": "start",
        "color": "ink",
        "bold": true
       },
       {
        "t": "text",
        "x": 160,
        "y": 85,
        "text": "Area = 12 × 8",
        "size": 14,
        "anchor": "middle",
        "color": "ink"
       }
      ]
     },
     "caption": "A rectangle 12 m long and 8 m wide.",
     "alt": "A rectangle labelled 12 m on the top side and 8 m on the right side. Inside it is written area equals 12 times 8."
    },
    {
     "type": "key",
     "style": "retenir",
     "title": "Units",
     "md": "Perimeter is a **length**: cm, m, km. Area is in **square units**: cm², m², km². A square metre (1 m²) is the area of a square with sides of 1 m. A football pitch or a plot of land is measured in m²."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- Writing the area in metres instead of square metres.\n- Adding only two sides for the perimeter: add all four (or double the sum of length and width).\n- Multiplying for the perimeter or adding for the area.\n- Mixing up the units: change cm to m first."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "A rectangular school garden is 12 m long and 8 m wide. Find its perimeter and area.",
     "steps": [
      "Perimeter = 2 × (12 + 8) = 2 × 20 = 40 m.",
      "Area = 12 × 8 = 96 m²."
     ],
     "answer": "Perimeter 40 m; area 96 m².",
     "figure": {
      "kind": "shapes",
      "w": 400,
      "h": 160,
      "items": [
       {
        "t": "rect",
        "x": 60,
        "y": 30,
