        "h": 100,
        "stroke": "ink",
        "width": 3,
        "fill": "lightyellow"
       },
       {
        "t": "text",
        "x": 160,
        "y": 20,
        "text": "12 m",
        "size": 14,
        "anchor": "middle",
        "color": "ink",
        "bold": true
       },
       {
        "t": "text",
        "x": 272,
        "y": 85,
        "text": "8 m",
        "size": 14,
        "anchor": "start",
        "color": "ink",
        "bold": true
       },
       {
        "t": "text",
        "x": 160,
        "y": 85,
        "text": "Area = 12 × 8",
        "size": 14,
        "anchor": "middle",
        "color": "ink"
       }
      ]
     }
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "A square classroom has a side of 7 m. What is its area?",
     "steps": [
      "Area of a square = side × side.",
      "7 × 7 = 49."
     ],
     "answer": "49 m²"
    }
   ],
