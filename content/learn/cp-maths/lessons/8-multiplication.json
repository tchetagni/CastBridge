   "blocks": [
    {
     "type": "text",
     "md": "Quand on a **plusieurs groupes égaux**, on peut calculer plus vite. Par exemple 3 groupes de 4 : 4 + 4 + 4 = 12."
    },
    {
     "type": "key",
     "style": "definition",
     "title": "La multiplication",
     "md": "3 × 4 se lit « trois fois quatre ». Cela veut dire 4 + 4 + 4 = 12.\n\nLe signe **×** veut dire « fois ». On l'utilise quand les groupes sont **égaux**."
    },
    {
     "type": "illustration",
     "figure": {
      "kind": "count",
      "n": 12,
      "shape": "square",
      "color": "green",
      "perRow": 4,
      "w": 260,
      "h": 200
     },
     "caption": "3 lignes de 4 : 3 × 4 = 12.",
     "alt": "Douze carrés verts rangés en 3 lignes de 4. Trois fois quatre font douze."
    },
    {
     "type": "example",
     "title": "Exemple 1 : addition répétée",
     "statement": "Écris 4 × 2 avec une addition.",
     "steps": [
      {
       "md": "4 × 2, c'est 4 fois le nombre 2."
      },
      {
       "md": "2 + 2 + 2 + 2 = 8."
      }
     ],
     "answer": "4 × 2 = **8**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : ×5",
     "statement": "Un régime a 5 bananes. Combien de bananes dans 3 régimes ?",
     "steps": [
      {
       "md": "3 groupes de 5 : 5 + 5 + 5."
      },
      {
       "md": "5 + 5 = 10 ; 10 + 5 = 15."
      }
     ],
     "answer": "3 × 5 = **15** bananes."
    },
    {
     "type": "key",
     "style": "retenir",
     "title": "Pour calculer vite",
     "md": "- × 2 : c'est le double (6 × 2 = 12).\n- × 10 : on pense aux dizaines (4 × 10 = 40).\n- × 5 : on compte de 5 en 5 : 5, 10, 15, 20..."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Attention",
     "md": "Une multiplication n'est possible que si tous les groupes sont **égaux**."
    },
