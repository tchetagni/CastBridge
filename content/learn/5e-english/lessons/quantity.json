    },
    {
     "type": "example",
     "title": "Exemple 1 : classer",
     "statement": "Dénombrable ou indénombrable ? orange, milk, chair, bread",
     "steps": [
      {
       "md": "On peut compter une orange et une chaise : dénombrables."
      },
      {
       "md": "On ne compte pas le lait ni le pain (on dit une bouteille de lait, un pain)."
      }
     ],
     "answer": "**orange, chair : dénombrables ; milk, bread : indénombrables**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : corriger",
     "statement": "Corrige : « I need two rices and an information. »",
     "steps": [
      {
       "md": "rice et information sont indénombrables : pas de s, pas de a/an."
      },
      {
       "md": "On utilise un contenant : two bags of rice ; some information."
      }
