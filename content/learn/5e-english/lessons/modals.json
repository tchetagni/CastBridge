    {
     "type": "example",
     "title": "Exemple 1 : règle de l'école",
     "statement": "Écris une règle : « Il est interdit d'utiliser un téléphone en classe. »",
     "steps": [
      {
       "md": "Interdit = mustn't."
      },
      {
       "md": "Utiliser un téléphone = use a phone."
      }
     ],
     "answer": "**You mustn't use a phone in class.**"
    },
    {
     "type": "example",
