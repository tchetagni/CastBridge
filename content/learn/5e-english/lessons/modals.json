  {
   "id": "5e-english-can",
   "title": "Can and can't: ability, permission, requests",
   "minutes": 25,
   "programRef": "5e — Anglais (APC), can, could (à vérifier sur le texte officiel)",
   "status": "draft",
   "author": "CastBridge (brouillon IA, bêta)",
   "source": "Rédaction originale d'après le programme MINESEC ; à relire par un enseignant",
   "objectives": [
    "Exprimer une capacité (can / can't).",
    "Demander une permission ou faire une demande poliment (Can I…? Could you…?)."
   ],
   "prerequisites": [],
   "exercises": [
    "5e-english-can-01",
    "5e-english-can-02",
    "5e-english-can-03",
