  {
   "id": "5e-english-must-have-to",
   "title": "Must, mustn't and have to",
   "minutes": 25,
   "programRef": "5e — Anglais (APC), must, have to (à vérifier sur le texte officiel)",
   "status": "draft",
   "author": "CastBridge (brouillon IA, bêta)",
   "source": "Rédaction originale d'après le programme MINESEC ; à relire par un enseignant",
   "objectives": [
    "Exprimer l'obligation (must / have to) et l'interdiction (mustn't).",
    "Distinguer mustn't et don't have to."
   ],
   "prerequisites": [
    "5e-english-can"
   ],
   "exercises": [
    "5e-english-must-have-to-01",
    "5e-english-must-have-to-02",
    "5e-english-must-have-to-03",
    "5e-english-must-have-to-04",
    "5e-english-must-have-to-05",
    "5e-english-must-have-to-06"
   ],
   "selfCheck": [
    "5e-english-must-have-to-q1",
    "5e-english-must-have-to-q2",
