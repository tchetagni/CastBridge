    {
     "type": "example",
     "title": "Exemple 1 : capacité",
     "statement": "Écris : « Amina sait jouer du piano mais elle ne sait pas chanter. »",
     "steps": [
      {
       "md": "Savoir faire = can ; piano = play the piano."
      },
      {
       "md": "Négation : can't sing."
      }
     ],
     "answer": "**Amina can play the piano but she can't sing.**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : poli",
