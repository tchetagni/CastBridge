   "id": "lower6-further-maths-series-sums",
   "title": "Summation of series and the method of differences",
   "minutes": 25,
   "programRef": "Cameroon GCE Board — Advanced Level Further Mathematics syllabus (Lower Sixth part; scope to be checked against the official text)",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Use the standard results for $\\sum r$, $\\sum r^2$, $\\sum r^3$",
    "Sum series using these results",
    "Use the method of differences with partial fractions"
   ],
   "prerequisites": [],
