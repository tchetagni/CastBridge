    {
     "type": "example",
     "title": "Example 2",
     "statement": "Find the square roots of $3+4i$.",
     "steps": [
      "Let $(a+bi)^2=3+4i$: $a^2-b^2=3$ and $2ab=4$ so $b=\\frac2a$.",
      "$a^2-\\frac{4}{a^2}=3$ gives $a^4-3a^2-4=0$, $(a^2-4)(a^2+1)=0$, $a=\\pm2$, $b=\\pm1$."
     ],
     "answer": "$\\pm(2+i)$"
    }
