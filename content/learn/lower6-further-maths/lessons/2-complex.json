  {
   "id": "lower6-further-maths-complex-polar",
   "title": "Modulus–argument form and De Moivre's theorem",
   "minutes": 25,
   "programRef": "Cameroon GCE Board — Advanced Level Further Mathematics syllabus (Lower Sixth part; scope to be checked against the official text)",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Write complex numbers in modulus–argument form",
    "Multiply and divide in polar form",
    "Use De Moivre's theorem for powers and trigonometric identities"
   ],
   "prerequisites": [],
