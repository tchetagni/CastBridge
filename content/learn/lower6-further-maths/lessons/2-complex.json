   ],
   "blocks": [
    {
     "type": "key",
     "style": "formule",
     "title": "Polar form",
     "md": "$z=r(\\cos\\theta+i\\sin\\theta)$ with $r=|z|$ and $\\theta=\\text{arg}\\, z$, $-\\pi<\\theta\\leq\\pi$ (principal argument). Find $\\theta$ from $\\tan\\theta=\\frac ba$, checking the quadrant on the Argand diagram."
    },
    {
     "type": "key",
     "style": "propriete",
     "title": "Products and quotients",
     "md": "$|z_1z_2|=|z_1||z_2|$ and $\\text{arg}\\,(z_1z_2)=\\text{arg}\\, z_1+\\text{arg}\\, z_2$; $\\left|\\frac{z_1}{z_2}\\right|=\\frac{|z_1|}{|z_2|}$ and $\\text{arg}\\,\\frac{z_1}{z_2}=\\text{arg}\\, z_1-\\text{arg}\\, z_2$ (mod $2\\pi$). Multiplying by $z$ scales by $|z|$ and rotates by $\\text{arg}\\, z$."
    },
    {
     "type": "key",
     "style": "formule",
     "title": "De Moivre's theorem",
     "md": "For any integer $n$: $[r(\\cos\\theta+i\\sin\\theta)]^n=r^n(\\cos n\\theta+i\\sin n\\theta)$. Compact notation: $e^{i\\theta}=\\cos\\theta+i\\sin\\theta$. It gives $(\\cos\\theta+i\\sin\\theta)^3=\\cos3\\theta+i\\sin3\\theta$, from which multiple-angle identities follow by comparing real and imaginary parts."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "A calculator gives $\\text{arctan}\\,\\frac ba$ only in the first or fourth quadrant: $-1+i$ has argument $\\frac{3\\pi}{4}$, not $-\\frac{\\pi}{4}$. Adding arguments may exceed $\\pi$: subtract $2\\pi$ to return to the principal range."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "Write $1+i\\sqrt3$ in polar form and find $(1+i\\sqrt3)^6$.",
     "steps": [
      "$r=\\sqrt{1+3}=2$, $\\tan\\theta=\\sqrt3$ in the first quadrant: $\\theta=\\frac\\pi3$.",
      "$(1+i\\sqrt3)^6=2^6(\\cos2\\pi+i\\sin2\\pi)=64$."
     ],
     "answer": "$2\\left(\\cos\\frac\\pi3+i\\sin\\frac\\pi3\\right)$; the sixth power is 64",
