   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Teen numbers",
     "md": "After 10 we say eleven, twelve, thirteen, fourteen, fifteen, sixteen, seventeen, eighteen, nineteen, twenty. Each of them is **ten and some more**. 13 is ten and three."
    },
    {
     "type": "illustration",
     "figure": {
      "kind": "count",
      "n": 16,
      "shape": "square",
      "color": "blue",
      "perRow": 8,
      "w": 360,
      "h": 100
     },
     "caption": "Sixteen blue squares: two rows of eight.",
     "alt": "Sixteen blue squares in two rows."
    },
    {
     "type": "key",
     "style": "retenir",
     "title": "Ten and ones",
     "md": "Make a group of 10. The things left over are the ones. 10 and 4 more is 14. 10 and 9 more is 19."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- Do not say *tenteen*. Say eleven, twelve.\n- 12 is not 21. In 12 the 1 is first.\n- Do not forget the group of ten."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "There are 10 red balls and 3 blue balls. How many balls in all?",
     "steps": [
      "Ten red balls make one group of ten.",
      "Ten and three more is thirteen."
     ],
     "answer": "13 balls",
     "figure": {
      "kind": "count",
      "n": 13,
      "shape": "circle",
      "color": "red",
      "perRow": 5,
      "w": 300,
      "h": 130
     }
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "Count the stars: 15.",
     "steps": [
      "Count the first ten: one to ten.",
      "Go on: eleven, twelve, thirteen, fourteen, fifteen."
     ],
     "answer": "15 stars",
     "figure": {
      "kind": "count",
      "n": 15,
      "shape": "star",
      "color": "yellow",
      "perRow": 5,
      "w": 300,
      "h": 130
     }
    }
