   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Addition rules",
     "md": "0+0 = 0; 0+1 = 1; 1+1 = 10 (write 0, carry 1); 1+1+1 = 11 (write 1, carry 1). Add from the right, carrying to the next column."
    },
    {
     "type": "key",
     "style": "retenir",
     "title": "Shifts",
     "md": "A **left shift** by one place doubles a binary number; a **right shift** halves it (for whole numbers). Bits that go off the end are lost."
    },
    {
