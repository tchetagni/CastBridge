    {
     "type": "example",
     "title": "Exemple 1 — formule de total",
     "statement": "Dans la feuille de l'illustration, D2 contient la formule =B2\\*C2. Quelle est sa valeur, et que devient la formule recopiée en D3 ?",
     "steps": [
      {
       "md": "D2 : 3 × 700 = 2 100."
      },
      {
       "md": "Recopiée en D3, la formule devient =B3\\*C3, soit 2 × 1 200 = 2 400."
      }
     ],
     "answer": "**D2 = 2 100 ; D3 contient =B3\\*C3 et vaut 2 400.**"
    },
    {
     "type": "example",
     "title": "Exemple 2 — somme et moyenne",
     "statement": "D2 vaut 2 100, D3 vaut 2 400, D4 vaut 2 000. Calcule =SOMME(D2:D4) et =MOYENNE(C2:C4) (prix : 700, 1 200, 500).",
     "steps": [
      {
       "md": "Somme : 2 100 + 2 400 + 2 000 = 6 500."
      },
      {
       "md": "Moyenne des prix : (700 + 1 200 + 500) ÷ 3 = 800."
      }
     ],
     "answer": "**Somme : 6 500 ; moyenne : 800.**"
    },
    {
     "type": "example",
     "title": "Exemple 3 — SI",
     "statement": "D5 vaut 6 500. Que renvoie =SI(D5>5000 ; \"Remise\" ; \"Non\") ?",
     "steps": [
      {
       "md": "Test : 6 500 > 5 000 est vrai."
      },
      {
       "md": "La formule renvoie donc la première valeur."
      }
     ],
     "answer": "**Elle renvoie « Remise ».**"
    },
    {
     "type": "example",
     "title": "Exemple 4 — référence absolue",
     "statement": "B6 contient le taux 0,1 (donnée fictive). En E2, on écrit =D2\\*\\$B\\$6, puis on recopie vers le bas. Que contient E3 et quelle valeur ?",
     "steps": [
      {
       "md": "Seule la ligne de D change ; \\$B\\$6 reste fixe : E3 contient =D3\\*\\$B\\$6."
      },
      {
       "md": "Valeur : 2 400 × 0,1 = 240."
      }
     ],
     "answer": "**E3 = D3\\*\\$B\\$6, valeur 240.**"
    },
