  {
   "id": "4e-maths-puissances",
   "title": "Les puissances d'un nombre et l'écriture scientifique",
   "minutes": 25,
   "programRef": "4e — Puissances d'exposant entier ; puissances de 10 ; écriture scientifique (à vérifier sur le texte officiel)",
   "status": "draft",
   "author": "CastBridge (brouillon IA, bêta)",
   "source": "Rédaction originale d'après le programme MINESEC ; à relire par un enseignant",
   "objectives": [
    "Calculer une puissance entière d'un nombre.",
    "Utiliser les règles sur les puissances de même base.",
    "Écrire un nombre en notation scientifique."
   ],
   "prerequisites": [
    "4e-maths-relatifs"
