   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Fraction",
     "md": "Une fraction $\\frac{a}{b}$ (avec $b\\neq0$) représente $a$ divisé par $b$. On ne change pas sa valeur en multipliant ou en divisant le numérateur et le dénominateur par le même nombre non nul : $\\frac{6}{8}=\\frac{3}{4}$."
    },
    {
     "type": "illustration",
     "caption": "Les trois quarts d'un segment.",
     "alt": "Un segment coupé en 4 parts égales dont 3 sont colorées.",
     "figure": {
      "kind": "shapes",
