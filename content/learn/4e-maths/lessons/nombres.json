   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Racine carrée",
     "md": "La racine carrée d'un nombre positif $a$, notée $\\sqrt{a}$, est **le nombre positif dont le carré est $a$**. Ainsi $\\sqrt{49}=7$ car $7^2=49$. On a toujours $(\\sqrt{a})^2=a$ et $\\sqrt{a^2}=a$ pour $a\\geq0$. Un nombre négatif n'a pas de racine carrée."
    },
    {
     "type": "illustration",
     "caption": "Si l'aire d'un carré est 49, son côté vaut 7 (la racine carrée de 49).",
     "alt": "Deux carrés : l'un d'aire 49 et de côté 7, l'autre d'aire 25 et de côté 5.",
