   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Bar chart",
     "md": "A **bar chart** uses bars to show numbers. A taller bar means a bigger number. The labels under the bars tell what each bar is."
    },
    {
     "type": "illustration",
     "figure": {
      "kind": "bars",
      "w": 400,
      "h": 240,
      "bars": [
       {
        "label": "Mon",
        "value": 3,
        "color": "blue"
       },
       {
        "label": "Tue",
        "value": 5,
        "color": "blue"
       },
       {
        "label": "Wed",
        "value": 4,
        "color": "blue"
       },
       {
        "label": "Thu",
        "value": 7,
        "color": "blue"
       },
       {
        "label": "Fri",
        "value": 2,
        "color": "blue"
       }
      ],
      "unit": "pupils"
     },
     "caption": "Pupils absent each day.",
     "alt": "A bar chart of absent pupils from Monday to Friday: 3, 5, 4, 7, 2."
    },
    {
     "type": "key",
     "style": "methode",
     "title": "Read it",
     "md": "1. Read the title. 2. Read the labels. 3. Look at the top of the bar and read across to the numbers. 4. Compare the bars."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- Read the top of the bar, not the middle.\n- The tallest bar is the biggest number.\n- Look at the unit."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "The chart shows pupils absent each day. How many were absent on Thursday?",
     "steps": [
      "Find Thursday and look at the top of its bar.",
      "The bar is at 7."
     ],
     "answer": "7 pupils",
     "figure": {
      "kind": "bars",
      "w": 400,
      "h": 240,
      "bars": [
       {
        "label": "Mon",
        "value": 3,
