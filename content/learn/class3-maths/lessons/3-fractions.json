    },
    {
     "type": "key",
     "style": "methode",
     "title": "Fraction of a number",
     "md": "To find 1/4 of 20: divide by 4. 20 ÷ 4 = 5. To find 3/4 of 20: find 1/4 (5) and multiply by 3: 15."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- 1/2 does not equal 1/4.\n- To find 3/5 of a number, divide by 5 first, then multiply by 3.\n- Same denominator: the bigger numerator is the bigger fraction."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "Find 1/5 of 30 mangoes.",
     "steps": [
      "Divide 30 by 5.",
      "30 ÷ 5 = 6."
     ],
     "answer": "6"
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "Find 3/4 of 28.",
     "steps": [
      "1/4 of 28 is 28 ÷ 4 = 7.",
      "3/4 is 3 × 7 = 21."
     ],
     "answer": "21"
    }
