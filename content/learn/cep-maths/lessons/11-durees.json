   "blocks": [
    {
     "type": "key",
     "style": "retenir",
     "title": "Les unités de temps",
     "md": "- 1 h = **60 min** ; 1 min = **60 s** ; donc 1 h = 3 600 s.\n- 1 jour = 24 h ; 1 semaine = 7 jours.\n- 1 an = 12 mois = 365 jours (366 jours pour une année bissextile).\n\nAttention : le système du temps n'est **pas décimal** : 1 h 30 min n'est pas 1,30 h mais **1,5 h**."
    },
    {
     "type": "example",
     "title": "Exemple 1 : convertir et additionner",
     "statement": "Convertis 2 h 45 min en minutes. Puis calcule 1 h 45 min + 2 h 30 min.",
     "steps": [
      {
       "md": "2 h 45 min = 2 × 60 + 45 = 120 + 45 = 165 min."
      },
      {
       "md": "1 h 45 min + 2 h 30 min : on additionne les heures (3 h) et les minutes (75 min)."
      },
      {
       "md": "75 min = 1 h 15 min, donc le total est 3 h + 1 h 15 min = 4 h 15 min."
      }
     ],
     "answer": "**165 min** ; puis **4 h 15 min**."
    },
