   "objectives": [
    "Reconnaître un multiple et un diviseur d'un nombre.",
    "Utiliser les critères de divisibilité par 2, 3, 5, 9 et 10.",
    "Trouver tous les diviseurs d'un nombre inférieur à 100."
   ],
