    {
     "type": "example",
     "title": "Intégrale d'un polynôme",
     "statement": "Calculer $\\int_0^3 (2x + 1)\\,dx$.",
     "steps": [
      {
       "md": "Primitive de $2x + 1$ : $F(x) = x^2 + x$.",
       "tex": "F(x) = x^2 + x"
