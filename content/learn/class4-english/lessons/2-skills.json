    {
     "type": "key",
     "style": "retenir",
     "title": "Irregular plurals and silent letters",
     "md": "Irregular plurals: **man - men, woman - women, child - children, foot - feet, tooth - teeth, mouse - mice**; **sheep** and **fish** do not change. **Silent letters** are not pronounced: **k** in *knife, know*; **w** in *write, wrong*; **b** in *lamb, comb*; **h** in *hour*."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- *Childs* or *mans*: use **children** and **men**.\n- *Citys*: it is **cities**.\n- *Wich* for *which*, or *thier* for *their*: learn the tricky spellings.\n- Leaving out silent letters: *nife*, *rite*."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "Write the plural of: bus, baby, tooth.",
     "steps": [
      "Bus ends in s: add es: buses. Baby ends in consonant + y: change y to ies: babies.",
      "Tooth is irregular: teeth."
     ],
     "answer": "buses, babies, teeth"
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "Which word has a silent letter: 'knee' or 'tree'?",
     "steps": [
      "In 'knee' the k is not pronounced.",
      "In 'tree' every letter is sounded."
     ],
     "answer": "knee (silent k)"
    }
