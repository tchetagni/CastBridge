   "title": "Sharing equally: dividing",
   "minutes": 12,
   "programRef": "MINEDUB primary school curriculum (English-speaking subsystem), Level I (Class 2) — Mathematics; to be checked against the official texts",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Share things into equal groups.",
    "Write a division sentence."
   ],
   "prerequisites": [
    "class2-maths-multiplication-groups"
