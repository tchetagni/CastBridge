   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Sharing",
     "md": "To **divide** is to share equally. 12 mangoes shared by 3 children: each gets 4. We write 12 ÷ 3 = 4. Say: twelve divided by three equals four."
    },
    {
     "type": "illustration",
     "figure": {
      "kind": "count",
      "n": 12,
      "shape": "circle",
      "color": "orange",
      "perRow": 4,
      "w": 300,
      "h": 120
     },
     "caption": "12 balls shared in 3 groups of 4.",
     "alt": "Twelve orange circles in three rows of four."
    },
    {
     "type": "key",
     "style": "retenir",
     "title": "Division and times",
