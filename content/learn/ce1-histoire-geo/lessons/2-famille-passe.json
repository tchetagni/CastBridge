     "type": "example",
     "title": "Exemple 1 : qui est qui ?",
     "statement": "La maman de ma maman, qui est-ce pour moi ?",
     "steps": [
      {
       "md": "La maman de ma maman est de la génération au-dessus de ma mère."
      },
      {
       "md": "C'est ma grand-mère."
      }
     ],
     "answer": "**Ma grand-mère.**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : trouver la génération",
     "statement": "Ngono a un frère, Paul. Quelle génération forment-ils ?",
     "steps": [
      {
       "md": "Ngono et Paul sont des enfants de la même famille."
      },
      {
       "md": "Ils ont à peu près le même âge : c'est la 3e génération du dessin."
      }
     ],
     "answer": "**Ils sont de la même génération : celle des enfants.**"
