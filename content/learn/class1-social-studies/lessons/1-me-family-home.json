   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Family",
     "md": "A **family** is a group of people who care for one another. It may have a father, a mother, sisters, brothers, grandparents, aunts, uncles and cousins. Families are not all the same size."
    },
    {
     "type": "illustration",
     "figure": {
      "kind": "count",
      "n": 6,
      "shape": "heart",
      "color": "red",
      "perRow": 6,
      "w": 300,
      "h": 79
     },
     "caption": "A family with six people.",
     "alt": "Six red hearts in a row, one for each person in a family."
    },
    {
     "type": "key",
     "style": "retenir",
     "title": "Helping",
     "md": "Family members **share work** and **help** each other. We say thank you. We respect older people. Children can sweep, fetch water, wash plates and look after little ones."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- Some children live with a grandmother, an aunt or other relatives. They are families too.\n- Do not say a family is wrong because it is different.\n- Everyone in the family has something to give."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "A family has a father, a mother and 3 children. How many people?",
     "steps": [
      "Count the adults: 2.",
      "Add the children: 2 + 3 = 5."
     ],
     "answer": "5 people",
     "figure": {
      "kind": "count",
      "n": 5,
      "shape": "circle",
      "color": "orange",
      "perRow": 5,
      "w": 300,
      "h": 79
     }
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "Name one job a child can do at home.",
     "steps": [
      "Children can help.",
      "Sweeping the yard."
     ],
     "answer": "Sweeping"
    }
   ],
   "readAloud": true,
   "chapter": "class1-social-studies-me-family-home"
