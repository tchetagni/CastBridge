     "title": "Degrés et radians",
     "statement": "Convertir 150° en radians, puis $\\pi/3$ rad en degrés.",
     "steps": [
      {
       "md": "$150 \\times \\pi / 180 = 5\\pi/6$.",
       "tex": "150° = \\frac{150\\pi}{180} = \\frac{5\\pi}{6}\\ \\text{rad}"
      },
      {
       "md": "$\\pi/3$ rad : on remplace $\\pi$ par 180°.",
       "tex": "\\frac{\\pi}{3} = \\frac{180°}{3} = 60°"
      }
     ],
     "answer": "**150° = 5π/6 rad ; π/3 rad = 60°.**"
    },
