   "blocks": [
    {
     "type": "key",
     "style": "formule",
     "title": "Coordonnées, norme, milieu",
     "md": "Dans un repère orthonormé, pour $A(x_A\\,;\\,y_A)$ et $B(x_B\\,;\\,y_B)$ :",
     "tex": "\\vec{AB}\\,(x_B - x_A\\,;\\,y_B - y_A) \\; AB = \\sqrt{(x_B - x_A)^2 + (y_B - y_A)^2} \\; I\\left(\\frac{x_A + x_B}{2}\\,;\\,\\frac{y_A + y_B}{2}\\right)"
    },
    {
     "type": "key",
     "style": "propriete",
     "title": "Opérations et colinéarité",
     "md": "- Somme : $\\vec{u}(a\\,;\\,b) + \\vec{v}(c\\,;\\,d) = (a + c\\,;\\,b + d)$ ; produit par un réel $k$ : $k\\vec{u} = (ka\\,;\\,kb)$.\n- $\\vec{u}$ et $\\vec{v}$ sont **colinéaires** (parallèles) si $ad - bc = 0$.\n- $ABCD$ est un **parallélogramme** si et seulement si $\\vec{AB} = \\vec{DC}$."
    },
    {
     "type": "key",
     "style": "propriete",
     "title": "Équation de droite",
     "md": "Une droite non verticale a une équation $y = mx + p$. Le **coefficient directeur** passant par $A$ et $B$ est $m = \\dfrac{y_B - y_A}{x_B - x_A}$ ; on trouve $p$ en remplaçant par un point."
    },
    {
     "type": "illustration",
     "figure": {
      "kind": "plot",
      "w": 420,
      "h": 260,
      "xmin": 0,
      "xmax": 8,
      "ymin": 0,
      "ymax": 6,
      "grid": 1,
      "xlabel": "x",
      "ylabel": "y",
      "points": [
       {
        "x": 1,
        "y": 2,
        "label": "A",
        "color": "blue"
       },
       {
        "x": 5,
        "y": 5,
        "label": "B",
        "color": "red"
       }
      ],
      "segments": [
       {
        "x1": 1,
        "y1": 2,
        "x2": 5,
        "y2": 5,
        "color": "ink",
        "dash": true
       },
       {
        "x1": 1,
        "y1": 2,
        "x2": 5,
        "y2": 2,
        "color": "grey",
        "dash": true
       },
       {
        "x1": 5,
        "y1": 2,
        "x2": 5,
        "y2": 5,
        "color": "grey",
        "dash": true
       }
      ]
     },
     "caption": "Le segment [AB] avec A(1 ; 2) et B(5 ; 5) : le triangle rectangle de côtés 4 et 3 donne AB = 5.",
     "alt": "Un repère avec les points A(1 ; 2) et B(5 ; 5) reliés par un segment. Un déplacement horizontal de 4 puis vertical de 3 (pointillés) forme un triangle rectangle."
    },
    {
     "type": "example",
     "title": "Vecteur, norme et milieu",
     "statement": "Soit A(1 ; 2) et B(5 ; 5). Calculer $\\vec{AB}$, $AB$ et le milieu de [AB].",
     "steps": [
      {
       "md": "Coordonnées du vecteur.",
       "tex": "\\vec{AB}(4\\,;\\,3)"
      },
      {
       "md": "Norme : Pythagore.",
       "tex": "AB = \\sqrt{4^2 + 3^2} = \\sqrt{25} = 5"
      },
      {
       "md": "Milieu.",
       "tex": "I\\left(\\frac{1+5}{2}\\,;\\,\\frac{2+5}{2}\\right) = (3\\,;\\,3,5)"
      }
     ],
     "answer": "**AB = 5 ; milieu (3 ; 3,5).**"
    },
    {
     "type": "example",
     "title": "Équation de la droite (AB)",
     "statement": "Déterminer l'équation de la droite (AB) pour A(1 ; 2) et B(5 ; 5).",
     "steps": [
      {
       "md": "Coefficient directeur.",
       "tex": "m = \\frac{5 - 2}{5 - 1} = 0,75"
      },
      {
       "md": "On remplace dans $y = mx + p$ avec A : $2 = 0{,}75 \\times 1 + p$.",
       "tex": "p = 2 - 0,75 = 1,25"
      }
     ],
     "answer": "**y = 0,75x + 1,25.**"
    },
    {
     "type": "example",
     "title": "Colinéarité",
     "statement": "$\\vec{u}(2\\,;\\,3)$ et $\\vec{v}(6\\,;\\,9)$ sont-ils colinéaires ?",
     "steps": [
      {
       "md": "On calcule $ad - bc$ avec $a=2, b=3, c=6, d=9$.",
       "tex": "2 \\times 9 - 3 \\times 6 = 0"
      },
      {
       "md": "Le résultat est nul : colinéaires ($\\vec{v} = 3\\vec{u}$)."
      }
     ],
     "answer": "**Oui, v = 3u.**"
    },
    {
     "type": "key",
     "style": "pieges",
