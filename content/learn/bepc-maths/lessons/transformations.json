  {
   "id": "bepc-maths-vecteurs",
   "title": "Vecteurs et coordonnées",
   "minutes": 35,
   "programRef": "3e — Vecteurs : coordonnées, norme, somme, translation (à vérifier sur le texte officiel)",
   "status": "draft",
   "author": "CastBridge (brouillon IA, bêta)",
   "source": "Rédaction originale d'après le programme MINESEC ; à relire par un enseignant",
   "objectives": [
    "Calculer les coordonnées d'un vecteur, sa norme, une somme.",
    "Montrer qu'un quadrilatère est un parallélogramme.",
    "Construire l'image d'un point par une translation."
   ],
   "prerequisites": [],
   "exercises": [
    "bepc-maths-vecteurs-01",
    "bepc-maths-vecteurs-02",
    "bepc-maths-vecteurs-03",
