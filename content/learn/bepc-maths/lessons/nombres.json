     "type": "example",
     "title": "Exemple 1 : opérations sur un encadrement",
     "statement": "On sait que $3\\leq x\\leq5$. Encadre $2x+1$ puis $-x$.",
     "steps": [
      {
       "md": "On multiplie par 2 (positif) :",
       "tex": "6\\leq2x\\leq10"
      },
      {
       "md": "On ajoute 1 :",
       "tex": "7\\leq2x+1\\leq11"
      },
      {
       "md": "On multiplie par $-1$ : les inégalités se renversent :",
       "tex": "-5\\leq-x\\leq-3"
      }
     ],
     "answer": "**$7\\leq2x+1\\leq11$ et $-5\\leq-x\\leq-3$**"
    },
