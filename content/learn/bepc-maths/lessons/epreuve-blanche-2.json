   "kind": "problem",
   "prompt": "On donne $A=\\sqrt{50}-3\\sqrt{2}+\\sqrt{8}$ et $B=(3+\\sqrt{5})(3-\\sqrt{5})$.",
   "parts": [
    {
     "kind": "mcq",
     "prompt": "Écris $A$ sous la forme $a\\sqrt{2}$.",
     "choices": [
      "$6\\sqrt{2}$",
      "$4\\sqrt{2}$",
      "$2\\sqrt{2}$",
      "$\\sqrt{55}$"
     ],
     "answer": 1,
     "points": 1,
     "difficulty": 1,
     "explanation": "$\\sqrt{50}=5\\sqrt{2}$ et $\\sqrt{8}=2\\sqrt{2}$ donc $A=5\\sqrt{2}-3\\sqrt{2}+2\\sqrt{2}=4\\sqrt{2}$.",
     "id": "bepc-maths-ep2-01-a"
    },
    {
     "kind": "numeric",
     "prompt": "Calcule $B$.",
     "answer": 4,
     "points": 1,
     "difficulty": 1,
     "explanation": "$(a+b)(a-b)=a^2-b^2$ : $9-5=4$.",
     "id": "bepc-maths-ep2-01-b"
    },
    {
     "kind": "mcq",
     "prompt": "Rends rationnel le dénominateur de $\\frac{6}{\\sqrt{3}}$.",
     "choices": [
      "$\\frac{6}{3}$",
      "$6\\sqrt{3}$",
      "$3\\sqrt{2}$",
      "$2\\sqrt{3}$"
     ],
     "answer": 3,
     "points": 1,
     "difficulty": 1,
     "explanation": "$\\frac{6}{\\sqrt{3}}=\\frac{6\\sqrt{3}}{3}=2\\sqrt{3}$.",
     "id": "bepc-maths-ep2-01-c"
    },
    {
     "kind": "numeric",
     "prompt": "Donne la valeur approchée de $A$ arrondie au dixième.",
     "answer": 5.7,
     "tolerance": 0.05,
     "points": 1,
     "difficulty": 1,
     "explanation": "$4\\sqrt{2}\\approx4\\times1{,}4142=5{,}657$, soit 5,7.",
     "id": "bepc-maths-ep2-01-d"
    }
   ],
   "difficulty": 2,
   "method": "Simplifier chaque radical avant d'additionner.",
