   "id": "bepc-maths-problemes-types",
   "title": "Problème de géométrie type BEPC : Pythagore, Thalès et trigonométrie",
   "minutes": 40,
   "programRef": "3e — Résolution de problèmes de géométrie (à vérifier sur le texte officiel)",
   "status": "draft",
   "author": "CastBridge (brouillon IA, bêta)",
   "source": "Rédaction originale d'après le programme MINESEC ; à relire par un enseignant",
   "objectives": [
    "Enchaîner Pythagore, Thalès et trigonométrie dans un même problème.",
    "Rédiger une solution complète en justifiant chaque résultat."
   ],
   "prerequisites": [
    "bepc-maths-pythagore",
    "bepc-maths-thales",
    "bepc-maths-trigo"
   ],
