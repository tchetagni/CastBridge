   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "$e^x$ and $\\ln x$",
     "md": "$e\\approx2.718$. The function $y=e^x$ is its own derivative. $\\ln x$ is the inverse of $e^x$: $e^{\\ln x}=x$ and $\\ln(e^x)=x$. Their graphs are reflections in $y=x$; $\\ln x$ is defined only for $x>0$."
    },
    {
     "type": "key",
     "style": "formule",
     "title": "Calculus",
     "md": "$\\frac{d}{dx}e^{kx}=ke^{kx}$, $\\frac{d}{dx}\\ln x=\\frac1x$; $\\int e^{kx}dx=\\frac{e^{kx}}{k}+C$, $\\int\\frac1x\\,dx=\\ln|x|+C$. Solving: $e^{f}=a\\Rightarrow f=\\ln a$; $\\ln f=b\\Rightarrow f=e^b$."
    },
    {
     "type": "key",
     "style": "methode",
     "title": "Growth and decay models",
     "md": "$N=N_0e^{kt}$ models growth ($k>0$) or decay ($k<0$); $N_0$ is the starting value. To find the time for a given change take $\\ln$ of both sides. Doubling time: $e^{kt}=2\\Rightarrow t=\\frac{\\ln2}{k}$."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "$\\frac{d}{dx}e^{2x}=2e^{2x}$, not $2xe^{2x-1}$. $\\ln(x^2)=2\\ln|x|$, not $2\\ln x$ for negative $x$. $\\ln(a+b)\\neq\\ln a+\\ln b$."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "Solve $e^{2x}=15$ and differentiate $y=e^{3x}+\\ln(2x)$.",
     "steps": [
      "$2x=\\ln15$, so $x=\\frac{\\ln15}{2}=\\frac{2.708}{2}=1.354$.",
      "$\\frac{dy}{dx}=3e^{3x}+\\frac{2}{2x}=3e^{3x}+\\frac1x$."
     ],
     "answer": "$x\\approx1.354$; $\\frac{dy}{dx}=3e^{3x}+\\frac1x$",
