   "id": "lower6-maths-differentiation-rules",
   "title": "Differentiation: rules, tangents and normals",
   "minutes": 25,
   "programRef": "Cameroon GCE Board — Advanced Level Mathematics, Pure Mathematics (to be checked against the official syllabus)",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Differentiate powers of $x$ term by term",
    "Find the gradient of a curve at a point",
    "Find equations of tangents and normals"
   ],
   "prerequisites": [],
   "exercises": [
