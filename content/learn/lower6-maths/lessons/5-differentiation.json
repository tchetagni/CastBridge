   ],
   "reviewNotes": [
    "Differentiation from first principles is not included; check whether the syllabus requires it.",
    "Syllabus references, scope and level of difficulty are to be checked against the official text; all facts, formulas and worked examples to be verified by a teacher before release."
   ],
   "blocks": [
    {
     "type": "key",
     "style": "formule",
     "title": "Power rule",
     "md": "If $y=ax^n$ then $\\frac{dy}{dx}=anx^{n-1}$ for any real $n$. Constants differentiate to 0. Differentiate term by term: $\\frac{d}{dx}(3x^4-2x^2+5x-1)=12x^3-4x+5$. Write roots and fractions as powers first: $\\sqrt{x}=x^{1/2}$, $\\frac{4}{x^2}=4x^{-2}$."
    },
    {
     "type": "key",
     "style": "definition",
     "title": "Gradient, tangent, normal",
     "md": "$\\frac{dy}{dx}$ gives the gradient of the curve at each point. The **tangent** at a point has that gradient; the **normal** is perpendicular to the tangent, so its gradient is $-\\frac{1}{m}$. The second derivative $\\frac{d^2y}{dx^2}$ is the derivative of $\\frac{dy}{dx}$."
    },
    {
     "type": "key",
     "style": "methode",
     "title": "Tangent or normal at $x=a$",
     "md": "1. Find $y$ at $x=a$. 2. Differentiate and find $m=\\frac{dy}{dx}$ at $x=a$. 3. Tangent: $y-y_1=m(x-a)$. Normal: use gradient $-\\frac1m$. 4. Check the point lies on your line."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- Differentiating $\\frac{4}{x^2}$ as $\\frac{4}{2x}$: rewrite as $4x^{-2}$ first.\n- Forgetting to subtract 1 from the power of a negative power: $x^{-2}\\to-2x^{-3}$.\n- Using the gradient of the tangent for the normal."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "Find the equations of the tangent and normal to $y=x^2-3x+2$ at $x=3$.",
     "steps": [
      "At $x=3$: $y=9-9+2=2$. $\\frac{dy}{dx}=2x-3=3$.",
      "Tangent: $y-2=3(x-3)$, i.e. $y=3x-7$.",
      "Normal: gradient $-\\frac{1}{3}$: $y-2=-\\frac{1}{3}(x-3)$, so $x+3y-9=0$."
     ],
     "answer": "Tangent $y=3x-7$; normal $x+3y-9=0$",
     "figure": {
      "kind": "plot",
      "xmin": -1,
      "xmax": 4.5,
      "ymin": -4,
      "ymax": 9,
      "grid": 1,
      "w": 400,
      "h": 260,
      "curves": [
       {
        "expr": "x^2-3x+2",
        "color": "blue"
       },
       {
        "expr": "3x-7",
        "color": "orange"
       }
      ],
      "points": [
       {
        "x": 3,
        "y": 2,
        "label": "(3, 2)",
        "color": "red"
       }
      ],
      "segments": [],
      "xlabel": "x"
     }
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "Find $\\frac{dy}{dx}$ for $y=2\\sqrt{x}+\\frac{4}{x^2}$.",
     "steps": [
      "Rewrite: $y=2x^{1/2}+4x^{-2}$.",
      "Differentiate: $x^{-1/2}-8x^{-3}$."
     ],
     "answer": "$\\frac{dy}{dx}=\\frac{1}{\\sqrt{x}}-\\frac{8}{x^3}$"
    }
   ],
