   "blocks": [
    {
     "type": "key",
     "style": "formule",
     "title": "Indefinite integral",
     "md": "$\\int ax^n\\,dx=\\frac{ax^{n+1}}{n+1}+C$ for $n\\neq-1$. Integration reverses differentiation. Always add the constant $C$ for an indefinite integral; use a given point on the curve to find it."
    },
    {
     "type": "key",
     "style": "formule",
     "title": "Definite integral and area",
     "md": "$\\int_a^b f(x)\\,dx=F(b)-F(a)$ where $F$ is an antiderivative of $f$. For $f(x)\\geq0$ on $[a,b]$ this is the area between the curve, the x-axis and $x=a$, $x=b$. The area between two curves is $\\int_a^b\\big(f(x)-g(x)\\big)dx$ where $f\\geq g$."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- Forgetting $+C$.\n- Area below the x-axis gives a NEGATIVE integral: take the positive value, and split the integral where the curve crosses the axis.\n- $\\int x^{-1}dx$ is not given by the power rule (it is $\\ln|x|$)."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "A curve passes through $(1,5)$ and has $\\frac{dy}{dx}=6x^2-4x+3$. Find its equation.",
     "steps": [
      "$y=\\int(6x^2-4x+3)dx=2x^3-2x^2+3x+C$.",
      "At $(1,5)$: $2-2+3+C=5$, so $C=2$."
     ],
     "answer": "$y=2x^3-2x^2+3x+2$"
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "Find the area under $y=x^2+1$ from $x=0$ to $x=3$.",
     "steps": [
      "$\\int_0^3(x^2+1)dx=\\left[\\frac{x^3}{3}+x\\right]_0^3$.",
      "$=(9+3)-(0)=12$."
     ],
     "answer": "Area $=12$ square units",
