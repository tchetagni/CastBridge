  {
   "id": "lower6-maths-stationary-points",
   "title": "Stationary points and optimisation",
   "minutes": 25,
   "programRef": "Cameroon GCE Board — Advanced Level Mathematics, Pure Mathematics (to be checked against the official syllabus)",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Find and classify stationary points",
    "Set up and solve optimisation problems",
    "Use increasing and decreasing"
   ],
   "prerequisites": [],
   "exercises": [
    "lower6-maths-differentiation-e07",
    "lower6-maths-differentiation-e08",
    "lower6-maths-differentiation-e09",
