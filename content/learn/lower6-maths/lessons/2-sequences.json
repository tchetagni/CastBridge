  {
   "id": "lower6-maths-ap-gp",
   "title": "Arithmetic and geometric series",
   "minutes": 25,
   "programRef": "Cameroon GCE Board — Advanced Level Mathematics, Pure Mathematics (to be checked against the official syllabus)",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Use the nth term and sum formulae of an arithmetic progression",
    "Use the nth term, finite sum and sum to infinity of a geometric progression",
    "Model growth in context"
   ],
   "prerequisites": [],
   "exercises": [
    "lower6-maths-sequences-e01",
    "lower6-maths-sequences-e02",
    "lower6-maths-sequences-e03",
    "lower6-maths-sequences-e04",
