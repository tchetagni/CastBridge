   "id": "lower6-maths-binomial",
   "title": "The binomial theorem",
   "minutes": 25,
   "programRef": "Cameroon GCE Board — Advanced Level Mathematics, Pure Mathematics (to be checked against the official syllabus)",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Expand $(a+b)^n$ for positive integer $n$",
    "Find a required term or coefficient",
    "Use the expansion to approximate powers"
   ],
   "prerequisites": [],
   "exercises": [
    "lower6-maths-sequences-e07",
