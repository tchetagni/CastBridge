   "id": "lower6-computer-boolean-logic",
   "title": "Boolean algebra and logic gates",
   "minutes": 30,
   "programRef": "Cameroon GCE Board — Advanced Level Computer Science syllabus (Lower Sixth part) — to be checked against the official text",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Describe NOT, AND, OR, NAND, NOR and XOR",
    "Complete truth tables",
    "Apply De Morgan's laws",
    "Write and interpret a logic expression"
   ],
   "prerequisites": [],
