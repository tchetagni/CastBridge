    {
     "type": "key",
     "style": "retenir",
     "title": "Characters",
     "md": "Characters are stored as numeric codes. **ASCII** is a 7-bit code (128 characters: letters, digits, punctuation, control codes). **Unicode** extends this to represent most of the world's writing systems (including accented letters used in French and African-language scripts). Characters in a text file are stored as a sequence of codes."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- 8-bit two's complement cannot store +128.\n- 11010011 as unsigned is 211, as two's complement is -45: the meaning depends on the interpretation.\n- Adding 1 after flipping: forgetting it gives the one's complement, not the negative.\n- ASCII 'A' (65) is not the digit 1."
    },
    {
     "type": "example",
     "title": "Example 1 - Negative number",
     "statement": "Write -45 in 8-bit two's complement and check.",
     "steps": [
      "45 = 00101101. Flip: 11010010. Add 1: 11010011.",
      "Check weights: -128 + 64 + 16 + 2 + 1 = -128 + 83 = -45."
     ],
     "answer": "11010011"
    },
    {
     "type": "example",
     "title": "Example 2 - Subtraction",
     "statement": "Compute 20 - 35 in 8-bit two's complement.",
     "steps": [
      "20 = 00010100. -35: 35 = 00100011, flip 11011100, +1 = 11011101.",
      "Add: 00010100 + 11011101 = 11110001. Weights: -128+64+32+16+1 = -15."
     ],
     "answer": "11110001 = -15"
    }
   ],
