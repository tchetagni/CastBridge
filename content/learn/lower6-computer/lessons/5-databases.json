    {
     "type": "key",
     "style": "methode",
     "title": "Changing data",
     "md": "INSERT INTO Student VALUES (6, 'Eve', 'Bali', 59); UPDATE Student SET Mark = 60 WHERE ID = 6; DELETE FROM Student WHERE ID = 6; Always include a WHERE in UPDATE and DELETE, or **every** row is changed or deleted."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- UPDATE or DELETE without WHERE affects all rows.\n- Using = on a NULL value: use IS NULL.\n- A foreign key must refer to an existing primary key value.\n- Text comparisons are case/format sensitive in many systems: 'Buea' and 'buea' may differ."
    },
    {
     "type": "example",
     "title": "Example 1 - Query",
     "statement": "Write SQL to list the names of students in Buea with Mark at least 50, highest mark first, using the table above.",
     "steps": [
      "SELECT Name FROM Student WHERE Town = 'Buea' AND Mark >= 50 ORDER BY Mark DESC;",
      "Buea students: Ada 72, Nina 55, Mary 41. Mark >= 50 keeps Ada and Nina; order: Ada, Nina."
     ],
     "answer": "Ada, Nina"
    },
    {
     "type": "example",
     "title": "Example 2 - Aggregate",
     "statement": "What do SELECT AVG(Mark) FROM Student; and SELECT COUNT(\\*) FROM Student WHERE Mark < 50; return?",
     "steps": [
      "AVG: (72 + 48 + 55 + 63 + 41) / 5 = 279 / 5 = 55.8.",
      "Marks below 50: Paul (48) and Mary (41), so COUNT = 2."
     ],
     "answer": "55.8 and 2"
    }
