    {
     "type": "example",
     "title": "Exemple 1 : 342 × 4",
     "statement": "Calcule 342 × 4.",
     "steps": [
      {
       "md": "Unités : 4 × 2 = 8. Dizaines : 4 × 4 = 16 : je pose 6 et je retiens 1."
      },
      {
       "md": "Centaines : 4 × 3 = 12, plus la retenue 1 = 13. Je pose 13."
      }
     ],
     "answer": "**342 × 4 = 1 368**"
    },
    {
     "type": "key",
     "style": "retenir",
     "title": "Multiplier par 10, 100, 1 000",
     "md": "- × 10 : j'ajoute **un zéro** à droite. 36 × 10 = 360.\n- × 100 : j'ajoute **deux zéros**. 25 × 100 = 2 500.\n- × 1 000 : j'ajoute **trois zéros**. 7 × 1 000 = 7 000.\n\nLe double d'un nombre, c'est ce nombre × 2 ; le triple, c'est × 3."
    },
    {
     "type": "example",
     "title": "Exemple 2 : ordre de grandeur",
     "statement": "Avant de calculer 463 × 5, trouve un ordre de grandeur.",
     "steps": [
      {
       "md": "463 est proche de 500. 500 × 5 = 2 500."
      },
      {
       "md": "Je calcule : 3 × 5 = 15 (je pose 5, je retiens 1) ; 6 × 5 = 30, plus 1 = 31 (je pose 1, je retiens 3) ; 4 × 5 = 20, plus 3 = 23."
      }
     ],
     "answer": "**463 × 5 = 2 315** (proche de 2 500 : c'est vraisemblable)."
