    {
     "type": "key",
     "style": "retenir",
     "title": "Kinds of processing",
     "md": "**Batch processing**: data is collected and processed all together later (for example monthly payslips). **Real-time (online) processing**: data is processed at once (for example a ticket booking system). **Interactive** processing replies immediately to the user."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Mistakes",
     "md": "- 'Garbage in, garbage out': wrong input gives wrong output.\n- A number alone is data; 'Ada scored 15/20' is information.\n- Real-time does not mean 'faster computer'; it means processed immediately."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "The marks 12, 15, 18 of three tests are data. Produce information.",
     "steps": [
      "Add the marks: 12 + 15 + 18 = 45.",
      "Average = 45 / 3 = 15, so the information is: average mark 15."
     ],
     "answer": "Average mark 15"
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "Decide batch or real-time: (a) a school prints all report cards at the end of term; (b) an ATM gives money immediately.",
     "steps": [
      "(a) Data collected over the term and processed together: batch.",
      "(b) Needs an immediate answer: real-time."
     ],
     "answer": "(a) batch; (b) real-time"
    }
