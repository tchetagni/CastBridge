   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Synonymes",
     "md": "Des **synonymes** sont des mots qui ont presque le **même sens** : *content* et *heureux* ; *joli* et *beau* ; *commencer* et *débuter*."
    },
    {
     "type": "key",
     "style": "definition",
     "title": "Contraires",
     "md": "Des **contraires** ont un sens **opposé** : *grand* ≠ *petit* ; *chaud* ≠ *froid* ; *ouvrir* ≠ *fermer* ; *jour* ≠ *nuit*."
    },
    {
     "type": "illustration",
