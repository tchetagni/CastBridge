    {
     "type": "example",
     "title": "Exemple 1 : a ou à ?",
     "statement": "Complète : « Ngono ___ un ballon. Elle joue ___ la cour. »",
     "steps": [
      {
       "md": "Je remplace par **avait** : « Ngono avait un ballon » : ça marche → **a**."
      },
      {
       "md": "« Elle joue avait la cour » : ça ne marche pas → **à**."
      }
     ],
     "answer": "**Ngono a un ballon. Elle joue à la cour.**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : et ou est ?",
     "statement": "Complète : « Le chat ___ noir ___ blanc. »",
     "steps": [
      {
       "md": "Premier trou : je remplace par était : « Le chat était noir » : ça marche → **est**."
      },
      {
       "md": "Deuxième trou : « noir et puis blanc » : ça marche → **et**."
      }
     ],
     "answer": "**Le chat est noir et blanc.**"
    },
    {
     "type": "exercise",
     "ref": "ce1-francais-homophones-a-et-01"
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Attention",
     "md": "- Je ne mets pas d'accent sur le **a** du verbe avoir.\n- Je mets un accent sur **à** (lieu, but).\n- On écrit **et** avec un t, **est** avec un s et un t (mais on n'entend pas la fin)."
    }
   ]
