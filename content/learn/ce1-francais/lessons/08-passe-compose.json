     "type": "example",
     "title": "Exemple 2 : reconnaître",
     "statement": "Quelle phrase est au passé composé : A « Elle mange. » B « Elle a mangé. » ?",
     "steps": [
      {
       "md": "Dans A, le verbe est en un seul mot : présent."
      },
      {
       "md": "Dans B, il y a deux mots : a + mangé."
      }
     ],
     "answer": "**La phrase B est au passé composé.**"
