    {
     "type": "example",
     "title": "Exemple 1 — décimal vers binaire",
     "statement": "Convertir 45 en binaire.",
     "steps": [
      {
       "md": "Divisions successives par 2 : $45=2×22+1$ ; $22=2×11+0$ ; $11=2×5+1$ ; $5=2×2+1$ ; $2=2×1+0$ ; $1=2×0+1$."
      },
      {
       "md": "Restes lus de bas en haut : $1,0,1,1,0,1$.",
       "tex": "45 = 101101_{2}"
      },
      {
       "md": "Contrôle : $32+8+4+1=45$ ✓."
      }
     ],
     "answer": "**$45=101101_{2}$.**"
    },
    {
     "type": "example",
     "title": "Exemple 2 — binaire vers décimal et hexadécimal",
     "statement": "Convertir $10110110_{2}$ en décimal et en hexadécimal.",
     "steps": [
      {
       "md": "Poids des bits à 1 : $128+32+16+4+2=182$.",
       "tex": "10110110_{2}=182"
      },
      {
       "md": "Groupes de 4 bits : $1011$ et $0110$ ; $1011_{2}=11=B$ et $0110_{2}=6$.",
       "tex": "1011|0110 → B6"
      },
      {
       "md": "Contrôle : $11×16+6=182$ ✓."
      }
     ],
     "answer": "**$10110110_{2}=182=B6_{16}$.**"
    },
    {
     "type": "example",
     "title": "Exemple 3 — octal",
     "statement": "Convertir $745_{8}$ en décimal puis en binaire.",
     "steps": [
      {
       "md": "$7×64+4×8+5=448+32+5=485$.",
       "tex": "745_{8}=7×8^{2}+4×8+5=485"
      },
      {
       "md": "Chaque chiffre octal devient 3 bits : $7→111$, $4→100$, $5→101$."
      },
      {
       "md": "Donc $745_{8}=111100101_{2}$ ; contrôle : 111100101."
      }
     ],
     "answer": "**$745_{8}=485=111100101_{2}$.**"
    },
    {
     "type": "example",
     "title": "Exemple 4 — addition binaire",
     "statement": "Calculer $1011_{2}+0110_{2}$.",
     "steps": [
      {
       "md": "On additionne colonne par colonne avec retenue ($1+1=10_{2}$) : bit 0 : $1+0=1$ ; bit 1 : $1+1=0$ retenue 1 ; bit 2 : $0+1+1=0$ retenue 1 ; bit 3 : $1+0+1=0$ retenue 1 ; nouvelle colonne : 1."
      },
      {
       "md": "Résultat : $10001_{2}$. Contrôle : $11+6=17=17$ ✓."
      }
     ],
     "answer": "**$1011_{2}+0110_{2}=10001_{2}$.**"
    },
