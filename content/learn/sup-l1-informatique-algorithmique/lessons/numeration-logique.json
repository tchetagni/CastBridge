    {
     "type": "example",
     "title": "Exemple 2 — De Morgan",
     "statement": "Vérifier que NON(A ET B) = NON A OU NON B.",
     "steps": [
      {
       "md": "On calcule les 4 lignes : (0,0) → A ET B = 0, NON = 1 ; NON A OU NON B = 1."
      },
      {
       "md": "(0,1) → 1 et 1 ; (1,0) → 1 et 1 ; (1,1) → A ET B = 1, NON = 0 ; NON A OU NON B = 0."
      },
      {
       "md": "Les deux colonnes sont identiques : équivalence démontrée."
      }
     ],
     "answer": "**Les deux expressions sont équivalentes.**"
