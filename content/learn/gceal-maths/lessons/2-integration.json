   ],
   "selfCheck": [
    "gceal-maths-integration-by-parts-q1",
    "gceal-maths-integration-by-parts-q2",
    "gceal-maths-integration-by-parts-q3",
    "gceal-maths-integration-by-parts-q4",
    "gceal-maths-integration-by-parts-q5"
   ],
   "reviewNotes": [
    "Syllabus references, scope and level of difficulty are to be checked against the official text; all facts, formulas and worked examples to be verified by a teacher before release."
   ],
   "blocks": [
    {
     "type": "key",
     "style": "formule",
     "title": "Integration by parts",
     "md": "$\\int u\\frac{dv}{dx}dx=uv-\\int v\\frac{du}{dx}dx$. Definite: $\\int_a^bu\\,v'\\,dx=[uv]_a^b-\\int_a^bv\\,u'\\,dx$. It undoes the product rule."
    },
    {
     "type": "key",
     "style": "methode",
     "title": "Choosing $u$",
     "md": "Pick $u$ as the part that becomes simpler when differentiated. A guide (LATE): Logarithm, then Algebraic ($x$, $x^2$), then Trigonometric, then Exponential. For $\\int\\ln x\\,dx$ take $u=\\ln x$ and $\\frac{dv}{dx}=1$. Repeat if needed ($x^2e^x$ needs two steps)."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- Sign errors in $uv-\\int v\\,du$ when $v$ is a $\\cos$ or $-\\sin$.\n- Choosing $u=e^x$ and $\\frac{dv}{dx}=x$: the integral becomes harder.\n- Forgetting to apply limits to the $uv$ term."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "Find $\\int xe^x\\,dx$.",
     "steps": [
      "$u=x$, $\\frac{dv}{dx}=e^x$: $\\frac{du}{dx}=1$, $v=e^x$.",
      "$\\int xe^xdx=xe^x-\\int e^xdx=xe^x-e^x+C=(x-1)e^x+C$."
     ],
     "answer": "$(x-1)e^x+C$",
     "figure": {
      "kind": "plot",
      "xmin": 0,
      "xmax": 2.2,
      "ymin": -0.2,
      "ymax": 3.5,
      "grid": 1,
      "w": 400,
      "h": 260,
      "curves": [
       {
        "expr": "x*exp(x)",
        "color": "blue"
       }
      ],
      "points": [
       {
        "x": 1,
        "y": 2.718281828459045,
        "label": "(1, e)",
        "color": "red"
       }
      ],
      "segments": [],
      "xlabel": "x"
     }
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "Evaluate $\\int_1^ex\\ln x\\,dx$.",
     "steps": [
      "$u=\\ln x$, $\\frac{dv}{dx}=x$: $\\frac{du}{dx}=\\frac1x$, $v=\\frac{x^2}{2}$.",
      "$\\left[\\frac{x^2}{2}\\ln x\\right]_1^e-\\int_1^e\\frac x2dx=\\frac{e^2}{2}-\\left[\\frac{x^2}{4}\\right]_1^e=\\frac{e^2}{2}-\\frac{e^2-1}{4}$."
     ],
     "answer": "$\\frac{e^2+1}{4}\\approx2.097$"
    }
   ],
