  {
   "id": "gceal-maths-integration-by-parts",
   "title": "Integration by parts",
   "minutes": 25,
   "programRef": "Cameroon GCE Board — Advanced Level Mathematics, Pure Mathematics (Upper Sixth part; to be checked against the official syllabus)",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Apply $\\int u\\,dv=uv-\\int v\\,du$",
    "Choose $u$ sensibly (LATE rule)",
    "Evaluate definite integrals by parts"
   ],
   "prerequisites": [],
   "exercises": [
    "gceal-maths-integration-e07",
    "gceal-maths-integration-e08",
    "gceal-maths-integration-e09",
