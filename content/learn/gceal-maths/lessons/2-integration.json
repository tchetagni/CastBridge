   "blocks": [
    {
     "type": "key",
     "style": "methode",
     "title": "Substitution",
     "md": "1. Choose $u$ (often the inside of a bracket or root, or the denominator). 2. Find $\\frac{du}{dx}$ and replace $dx$ (and every $x$) by $u$-terms. 3. Integrate in $u$. 4. Return to $x$. For a definite integral change the limits to $u$-values and do NOT return to $x$."
    },
    {
     "type": "key",
     "style": "propriete",
     "title": "Reverse chain rule shortcuts",
     "md": "$\\int f'(x)\\,[f(x)]^n\\,dx=\\frac{[f(x)]^{n+1}}{n+1}+C$ and $\\int\\frac{f'(x)}{f(x)}dx=\\ln|f(x)|+C$. For linear inside: $\\int(ax+b)^n\\,dx=\\frac{(ax+b)^{n+1}}{a(n+1)}+C$, $\\int\\frac{1}{ax+b}dx=\\frac1a\\ln|ax+b|+C$."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- Forgetting the factor $\\frac1a$ in $\\int(ax+b)^ndx$.\n- Changing the variable but keeping the old limits.\n- Leaving some $x$ in an integral that should be entirely in $u$."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "Find $\\int2x(x^2+1)^3dx$.",
     "steps": [
      "Let $u=x^2+1$, so $du=2x\\,dx$.",
      "$\\int u^3du=\\frac{u^4}{4}+C$; substitute back."
     ],
     "answer": "$\\frac{(x^2+1)^4}{4}+C$"
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "Evaluate $\\int_0^1x\\sqrt{1+x^2}\\,dx$.",
     "steps": [
      "$u=1+x^2$, $du=2x\\,dx$; limits: $x=0\\to u=1$, $x=1\\to u=2$.",
      "$\\frac{1}{2}\\int_1^2u^{1/2}du=\\frac{1}{2}\\cdot\\frac{2}{3}\\left[u^{3/2}\\right]_1^2=\\frac{1}{3}(2\\sqrt2-1)$."
     ],
     "answer": "$\\frac{2\\sqrt2-1}{3}\\approx0.609$",
