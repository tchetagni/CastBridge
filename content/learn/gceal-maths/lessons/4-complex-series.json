   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Complex numbers",
     "md": "$i^2=-1$. A complex number is $z=a+bi$ with real part $a$ and imaginary part $b$. Add/subtract real and imaginary parts separately; multiply like brackets and replace $i^2$ by $-1$. The **conjugate** of $z$ is $\\bar z=a-bi$ and $z\\bar z=a^2+b^2$ is real."
    },
    {
     "type": "key",
     "style": "methode",
     "title": "Division",
     "md": "To divide, multiply numerator and denominator by the conjugate of the denominator: $\\frac{2+i}{1-i}=\\frac{(2+i)(1+i)}{(1-i)(1+i)}=\\frac{1+3i}{2}$."
    },
    {
     "type": "key",
     "style": "formule",
     "title": "Argand diagram, modulus, argument",
     "md": "$z=a+bi$ is the point $(a,b)$. Modulus $|z|=\\sqrt{a^2+b^2}$; argument $\\theta=\\text{arg }z$ with $\\tan\\theta=\\frac ba$ (check the quadrant). A quadratic with real coefficients and $\\Delta<0$ has two roots that are complex conjugates: $x=\\frac{-b\\pm i\\sqrt{-\\Delta}}{2a}$."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "$i^2=-1$ not $+1$. The conjugate of $2-5i$ is $2+5i$ (only the sign of the imaginary part changes). Take care with the quadrant of the argument."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "Calculate $(3+2i)(1-4i)$.",
     "steps": [
      "Expand: $3-12i+2i-8i^2$.",
      "$i^2=-1$: $3-10i+8=11-10i$."
     ],
     "answer": "$11-10i$"
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "Solve $x^2-4x+13=0$.",
     "steps": [
      "$\\Delta=16-52=-36$, so $x=\\frac{4\\pm\\sqrt{-36}}{2}=\\frac{4\\pm6i}{2}$.",
      "Check: sum of roots $=4$, product $=(2+3i)(2-3i)=13$."
     ],
     "answer": "$x=2\\pm3i$",
