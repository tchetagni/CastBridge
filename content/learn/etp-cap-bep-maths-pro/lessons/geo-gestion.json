   ],
   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Devis et facture",
     "md": "Un **devis** est une estimation chiffrée proposée au client avant le travail. Une **facture** est le document final demandant le paiement. Chaque ligne indique : désignation, quantité, prix unitaire, montant = quantité × prix unitaire."
    },
    {
     "type": "key",
     "style": "methode",
     "title": "Calculer une facture",
     "md": "1. Montant de chaque ligne = quantité × prix unitaire.\n2. Total **hors taxe (HT)** = somme des lignes.\n3. Remise éventuelle, puis **TVA** avec le taux fourni.\n4. Total **TTC** = HT + TVA."
    },
    {
     "type": "key",
     "style": "methode",
     "title": "Lire un graphique",
     "md": "Lire le titre, les unités des axes, puis la hauteur de chaque barre. Comparer en calculant des différences ou des rapports. Un diagramme en bâtons sert à comparer des quantités entre catégories."
    },
    {
     "type": "example",
     "title": "Exemple 1 — devis",
     "statement": "Un plombier fictif propose : 3 robinets à 12 500 FCFA, 10 m de tuyau à 1 800 FCFA le mètre, 1 main-d'œuvre à 25 000 FCFA. Total hors taxe ?",
     "steps": [
      {
       "md": "Lignes : 3 × 12 500 = 37 500 ; 10 × 1 800 = 18 000 ; main-d'œuvre : 25 000."
      },
      {
       "md": "Somme : 37 500 + 18 000 + 25 000 = 80 500 FCFA."
      }
     ],
     "answer": "**80 500 FCFA HT.**"
    },
    {
     "type": "example",
     "title": "Exemple 2 — TTC",
     "statement": "Avec une TVA de 10 % donnée par l'énoncé fictif, quel est le TTC du devis précédent ?",
     "steps": [
      {
       "md": "TVA : 80 500 × 10 ÷ 100 = 8 050 FCFA."
      },
      {
       "md": "TTC : 80 500 + 8 050 = 88 550 FCFA."
      }
     ],
     "answer": "**88 550 FCFA TTC.**"
    },
    {
