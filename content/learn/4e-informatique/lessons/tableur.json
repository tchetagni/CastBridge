    {
     "type": "example",
     "title": "Exemple 1 : moyenne",
     "statement": "Les notes de Boris sont en B2:B5 : 12, 15, 9 et 14. Quelle formule donne sa moyenne et quelle est sa valeur ?",
     "steps": [
      {
       "md": "On écrit =MOYENNE(B2:B5)."
      },
      {
       "md": "Somme : 12 + 15 + 9 + 14 = 50 ; 50 ÷ 4 = 12,5."
      }
     ],
     "answer": "**=MOYENNE(B2:B5) donne 12,5**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : choisir un graphique",
     "statement": "Quel graphique choisir pour (a) comparer les notes de quatre matières ; (b) montrer l'évolution de la température sur 7 jours ; (c) montrer la part de chaque dépense dans un budget ?",
     "steps": [
