        "fill": "lightyellow",
        "radius": 6
       },
       {
        "t": "text",
        "x": 100.0,
        "y": 35.6,
        "text": "hop → hopping",
        "size": 16,
        "anchor": "middle",
        "color": "ink",
        "bold": true
       },
       {
        "t": "rect",
        "x": 200.0,
        "y": 8,
