   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Rules",
     "md": "Most nouns add **s**: book → books. Nouns ending in s, x, ch, sh add **es**: bus → buses, box → boxes, church → churches. Nouns ending in **consonant + y** change y to **ies**: baby → babies, story → stories."
    },
