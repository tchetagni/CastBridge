     "type": "example",
     "title": "Exemple 1 : quel jour ?",
     "statement": "Question : « What day is it today ? » Aujourd'hui, c'est mercredi. Que réponds-tu ?",
     "steps": [
      {
       "md": "« What day is it today ? » veut dire « Quel jour est-on ? »"
      },
      {
       "md": "On répond : « It's Wednesday. » (avec une majuscule)."
      }
     ],
     "answer": "**It's Wednesday.**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : le jour d'après",
     "statement": "Si today is Friday, what day is tomorrow ?",
     "steps": [
      {
       "md": "« Tomorrow » veut dire demain."
      },
      {
       "md": "Après Friday vient Saturday."
      }
     ],
     "answer": "**Tomorrow is Saturday.**"
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Attention",
     "md": "Écris « Monday » avec une **majuscule** et ne confonds pas **Thursday** (jeudi) et **Tuesday** (mardi)."
    },
    {
     "type": "more",
     "items": [
      "« Today » = aujourd'hui ; « tomorrow » = demain ; « yesterday » = hier ; « week » = semaine ; « month » = mois."
     ]
