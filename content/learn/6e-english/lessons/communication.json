   "title": "Writing short messages",
   "minutes": 30,
   "programRef": "6e — Anglais (APC), expression écrite : messages courts (à vérifier sur le texte officiel)",
   "status": "draft",
   "author": "CastBridge (brouillon IA, bêta)",
   "source": "Rédaction originale d'après le programme MINESEC ; à relire par un enseignant",
   "objectives": [
    "Écrire un message court (SMS, note, carte postale).",
    "Écrire un petit texte de présentation de 5 à 6 phrases."
   ],
   "prerequisites": [
    "6e-english-reading",
    "6e-english-present-continuous"
