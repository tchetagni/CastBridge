     "statement": "Écris deux phrases : « Mon père s'appelle Mballa. J'ai une soeur, elle s'appelle Amina. »",
     "steps": [
      {
       "md": "Père = father : « My father is Mballa. »"
      },
      {
       "md": "Sœur = sister : « I have a sister. Her name is Amina. »"
      }
     ],
     "answer": "**My father is Mballa. I have a sister. Her name is Amina.**"
    },
