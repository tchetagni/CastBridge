   ],
   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Expression littérale",
     "md": "Une **expression littérale** contient des lettres qui représentent des nombres. On remplace la lettre par un nombre pour obtenir la **valeur numérique**. On omet le signe × devant une lettre : $3x$ signifie $3 \\times x$."
    },
    {
     "type": "illustration",
     "caption": "Le périmètre d'un carré de côté x est P = 4x.",
     "alt": "Un carré de côté x et la formule P égale quatre x.",
     "figure": {
      "kind": "shapes",
      "w": 400,
      "h": 150,
      "items": [
       {
        "t": "rect",
        "x": 60,
        "y": 30,
        "w": 150,
        "h": 70,
        "fill": "lightyellow",
        "stroke": "ink",
        "width": 2
       },
       {
