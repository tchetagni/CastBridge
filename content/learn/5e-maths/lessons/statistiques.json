   "programRef": "5e — Statistiques : moyenne, médiane, étendue (à vérifier sur le texte officiel)",
   "status": "draft",
   "author": "CastBridge (brouillon IA, bêta)",
   "source": "Rédaction originale d'après le programme MINESEC ; à relire par un enseignant",
   "objectives": [
    "Calculer une moyenne simple ou pondérée.",
    "Déterminer la médiane et l'étendue d'une série."
   ],
   "prerequisites": [
    "5e-maths-frequences-diagrammes"
   ],
   "exercises": [
    "5e-maths-moyenne-mediane-01",
    "5e-maths-moyenne-mediane-02",
