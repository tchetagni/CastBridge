   "minutes": 25,
   "programRef": "5e — Statistiques : effectif, fréquence, diagrammes (à vérifier sur le texte officiel)",
   "status": "draft",
   "author": "CastBridge (brouillon IA, bêta)",
   "source": "Rédaction originale d'après le programme MINESEC ; à relire par un enseignant",
   "objectives": [
    "Calculer des fréquences et les exprimer en pourcentage.",
    "Lire et construire un diagramme en barres ou circulaire à partir d'un tableau."
   ],
   "prerequisites": [],
   "exercises": [
