   "blocks": [
    {
     "type": "key",
     "style": "methode",
     "title": "$n$th roots",
     "md": "To solve $z^n=w$ write $w=r(\\cos\\theta+i\\sin\\theta)$ (and $\\theta+2\\pi k$). Then $z=r^{1/n}\\left[\\cos\\frac{\\theta+2\\pi k}{n}+i\\sin\\frac{\\theta+2\\pi k}{n}\\right]$ for $k=0,1,s',n-1$. The $n$ roots lie on a circle of radius $r^{1/n}$, equally spaced at angles $\\frac{2\\pi}{n}$, forming a regular polygon. The $n$th roots of unity sum to 0."
    },
    {
     "type": "key",
     "style": "propriete",
     "title": "Standard loci",
     "md": "$|z-a|=r$: circle, centre $a$, radius $r$. $|z-a|=|z-b|$: perpendicular bisector of the line joining $a$ and $b$. $\\text{arg}\\,(z-a)=\\theta$: a half-line from $a$ at angle $\\theta$ (not including $a$). $|z-a|<r$: inside the circle."
    },
    {
     "type": "key",
     "style": "methode",
     "title": "Cartesian equation",
     "md": "Write $z=x+iy$ and use $|z-a|^2=(x-a_1)^2+(y-a_2)^2$. For $|z-a|=k|z-b|$ with $k\\neq1$ you get a circle: square both sides and complete the square."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "Giving fewer than $n$ roots. Using $\\text{arg}\\, z=\\frac{\\theta}{n}$ only and forgetting the $2\\pi k$ terms. In $|z-a|$ remember that $a$ is the CENTRE: $|z+1-2i|=3$ has centre $-1+2i$."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "Find the cube roots of 8.",
     "steps": [
      "$8=8(\\cos0+i\\sin0)$ so $z=2\\left[\\cos\\frac{2\\pi k}{3}+i\\sin\\frac{2\\pi k}{3}\\right]$.",
      "$k=0$: $2$. $k=1$: $2\\left(-\\frac{1}{2}+\\frac{\\sqrt3}{2}i\\right)=-1+i\\sqrt3$. $k=2$: $-1-i\\sqrt3$."
     ],
     "answer": "$2,\\;-1+i\\sqrt3,\\;-1-i\\sqrt3$",
