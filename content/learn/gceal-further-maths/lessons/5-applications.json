  {
   "id": "gceal-further-maths-shm",
   "title": "Simple harmonic motion",
   "minutes": 25,
   "programRef": "Cameroon GCE Board — Advanced Level Further Mathematics, Mechanics (to be checked)",
   "status": "draft",
   "author": "CastBridge (AI draft)",
   "source": "Original writing following the Cameroonian curriculum; to be reviewed by a teacher",
   "objectives": [
    "Recognise and solve $x''=-\\omega^2x$",
    "Use the formulae for speed, acceleration and period",
    "Model a mass on a spring"
   ],
   "prerequisites": [],
   "exercises": [
    "gceal-further-maths-applications-e01",
    "gceal-further-maths-applications-e02",
    "gceal-further-maths-applications-e03",
