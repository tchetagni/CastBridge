    {
     "type": "key",
     "style": "methode",
     "title": "Which way?",
     "md": "**Big unit to small unit: multiply** (3.5 km = 3.5 × 1,000 = 3,500 m). **Small unit to big unit: divide** (450 g = 450 ÷ 1,000 = 0.45 kg). For time use 60: 2 h 15 min = 2 × 60 + 15 = 135 min."
    },
    {
     "type": "key",
     "style": "pieges",
     "title": "Common mistakes",
     "md": "- Using 100 for time: there are 60 minutes in an hour.\n- Multiplying instead of dividing.\n- Adding measures in different units without converting.\n- Using the wrong unit in the answer (km instead of m)."
    },
    {
     "type": "example",
     "title": "Example 1",
     "statement": "A farmer has 2.5 kg of beans and buys 750 g more. How many kg in all?",
     "steps": [
      "Convert 750 g to kg: 750 ÷ 1,000 = 0.75 kg.",
      "2.5 + 0.75 = 3.25 kg."
     ],
     "answer": "3.25 kg"
    },
    {
     "type": "example",
     "title": "Example 2",
     "statement": "How many minutes in 2 hours 15 minutes?",
     "steps": [
      "2 hours = 2 × 60 = 120 minutes.",
      "120 + 15 = 135 minutes."
     ],
     "answer": "135 minutes"
    }
