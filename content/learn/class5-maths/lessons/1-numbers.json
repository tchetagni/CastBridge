   "blocks": [
    {
     "type": "key",
     "style": "definition",
     "title": "Factors and multiples",
     "md": "A **factor** of a number divides it exactly: the factors of 24 are 1, 2, 3, 4, 6, 8, 12 and 24. A **multiple** of a number is in its times table: multiples of 6 are 6, 12, 18, 24... A **prime number** has exactly two factors, 1 and itself (2, 3, 5, 7, 11, 13...). 1 is not prime. Other numbers above 1 are **composite**."
    },
