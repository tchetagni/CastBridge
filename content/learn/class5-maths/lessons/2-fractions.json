     "type": "example",
     "title": "Example 2",
     "statement": "A rope costs 350 FCFA per metre. How much do 2.5 m cost?",
     "steps": [
      "Multiply: 350 × 2.5 = 350 × 2 + 350 × 0.5.",
      "700 + 175 = 875."
     ],
     "answer": "875 FCFA"
