   "id": "bepc-english-use-of-english",
   "title": "Use of English : textes à trous et transformations",
   "minutes": 35,
   "programRef": "3e — Use of English : cloze, sentence transformation (à vérifier sur le texte officiel)",
   "status": "draft",
   "author": "CastBridge (brouillon IA, bêta)",
   "source": "Rédaction originale d'après le programme MINESEC ; à relire par un enseignant",
   "objectives": [
    "Compléter un texte à trous (articles, prépositions, auxiliaires, temps).",
    "Réécrire une phrase sans changer le sens (transformations)."
   ],
   "prerequisites": [
    "bepc-english-passive-voice",
    "bepc-english-reported-speech",
    "bepc-english-conditionals"
   ],
