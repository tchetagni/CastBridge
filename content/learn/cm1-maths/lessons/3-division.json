    {
     "type": "key",
     "style": "methode",
     "title": "Méthode pour poser",
     "md": "1. J'estime le quotient avec des multiples de 24 (24 × 10 = 240).\n2. Je cherche le plus grand multiple de 24 qui ne dépasse pas le morceau du dividende.\n3. Je soustrais ; j'abaisse le chiffre suivant ; je recommence.\n4. Je vérifie avec la preuve."
    },
    {
     "type": "example",
     "title": "Exemple 1 : quotient et reste",
     "statement": "Divise 1 575 par 24.",
     "steps": [
      {
       "md": "24 × 60 = 1 440 ; 1 575 − 1 440 = 135."
      },
      {
       "md": "24 × 5 = 120 ; 135 − 120 = 15."
      },
      {
       "md": "Quotient : 60 + 5 = 65 ; reste 15."
      }
     ],
     "answer": "**1 575 = 24 × 65 + 15**"
    },
    {
     "type": "example",
     "title": "Exemple 2 : un problème de groupement",
     "statement": "On range 500 œufs dans des boîtes de 12. Combien de boîtes pleines ?",
     "steps": [
      {
       "md": "500 ÷ 12 : 12 × 41 = 492."
      },
      {
       "md": "500 − 492 = 8 : il reste 8 œufs."
      },
      {
       "md": "Le reste est plus petit que 12 : c'est bon."
      }
     ],
     "answer": "**41 boîtes pleines et 8 œufs restants.**"
    },
