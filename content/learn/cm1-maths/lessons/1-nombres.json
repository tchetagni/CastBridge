     "statement": "Écris en chiffres : deux cent huit mille quatre cent trois.",
     "steps": [
      {
       "md": "Classe des mille : « deux cent huit » → 208."
      },
      {
       "md": "Classe des unités : « quatre cent trois » → 403."
      },
      {
       "md": "On assemble : 208 403."
      }
     ],
     "answer": "**208 403**"
    },
