  {
   "id": "droit-l3-administratif-contentieux-domaine-expropriation",
   "title": "Domaine public et expropriation pour cause d'utilité publique",
   "minutes": 35,
   "programRef": "Droit administratif et contentieux administratif (Licence 3) — à vérifier sur la maquette de l'établissement",
   "status": "draft",
   "author": "CastBridge (brouillon IA)",
   "source": "Rédaction originale ; à relire par un enseignant de droit",
   "objectives": [
    "Distinguer domaine public et domaine privé.",
    "Énoncer les principes d'inaliénabilité et d'imprescriptibilité.",
    "Décrire l'expropriation et l'indemnisation."
   ],
   "prerequisites": [],
