   "grammar": [
    {
     "id": "zh-a0-salut-fr-g1",
     "title": "Pas de conjugaison, pas d'article",
     "md": "Le chinois ne conjugue pas les verbes et n'utilise pas d'articles. L'ordre des mots suffit : **你好** (littéralement « toi bien ») veut dire « bonjour ». Un même mot sert pour tout le monde.",
     "examples": [
      {
       "text": "你好",
       "tr": "bonjour (littéralement : toi bien)"
      },
      {
       "text": "我很好",
       "tr": "je vais très bien (littéralement : moi très bien)"
      }
     ]
    },
    {
     "id": "zh-a0-salut-fr-g2",
     "title": "La particule 吗 forme la question",
     "md": "On ajoute **吗** (ma) en fin de phrase pour poser une question oui/non : **你好吗 ?** (comment vas-tu ?). La réponse reprend le mot clé : **好** (bien).",
     "examples": [
      {
       "text": "你好吗？",
       "tr": "Comment vas-tu ?"
      }
     ]
    }
   ],
