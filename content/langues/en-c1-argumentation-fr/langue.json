   "stories": [
    {
     "id": "en-c1-argumentation-fr-s1",
     "title": "Pour ou contre la gratuité",
     "paragraphs": [
      {
       "who": "",
       "text": "Many people advocate free higher education. They argue that it conveys a clear message: knowledge is a public good.",
       "tr": "Beaucoup préconisent l'enseignement supérieur gratuit. Ils soutiennent que cela transmet un message clair : le savoir est un bien public."
      },
      {
       "who": "",
       "text": "However, others assess the underlying cost. Consequently, the debate rests on how we value education.",
       "tr": "Cependant, d'autres évaluent le coût sous-jacent. Par conséquent, le débat repose sur la valeur que nous accordons à l'éducation."
      },
      {
       "who": "",
       "text": "A coherent policy must balance both perspectives, notwithstanding the difficulty.",
       "tr": "Une politique cohérente doit concilier les deux points de vue, malgré la difficulté."
      }
     ]
    }
