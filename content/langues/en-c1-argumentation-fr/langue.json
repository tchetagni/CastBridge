   "dialogues": [
    {
     "id": "en-c1-argumentation-fr-d1",
     "title": "Un débat",
     "lines": [
      {
       "who": "A",
       "text": "Do you think universities should be free?",
       "tr": "Penses-tu que les universités devraient être gratuites ?"
      },
      {
       "who": "B",
       "text": "That is a compelling argument, but I see a different perspective.",
       "tr": "C'est un argument convaincant, mais j'ai un autre point de vue."
      },
      {
       "who": "A",
       "text": "Moreover, education benefits the whole of society.",
       "tr": "De plus, l'éducation profite à toute la société."
      },
      {
       "who": "B",
       "text": "However, we must assess the cost to taxpayers.",
       "tr": "Cependant, nous devons évaluer le coût pour les contribuables."
      },
      {
       "who": "A",
       "text": "Consequently, a compromise may be the most coherent solution.",
       "tr": "Par conséquent, un compromis est peut-être la solution la plus cohérente."
      }
     ],
     "audio": "m:en-c1-argumentation-d1"
    }
   ],
   "grammar": [
    {
     "id": "en-c1-argumentation-fr-g1",
     "title": "Les connecteurs d'argumentation",
     "md": "**Moreover** (ajout), **however** (opposition), **consequently** (conséquence), **notwithstanding** (concession). Ils structurent un essai et marquent la progression de la pensée.",
     "examples": [
      {
       "text": "Moreover, it is widely accepted.",
       "tr": "De plus, c'est largement admis."
      }
     ]
    },
    {
     "id": "en-c1-argumentation-fr-g2",
     "title": "Le hedging (langue prudente)",
     "md": "À l'écrit académique, on nuance : **It may be argued that**, **It tends to suggest**. L'affirmation trop tranchée est pénalisée au niveau C1.",
     "examples": [
      {
       "text": "It may be argued that this is beneficial.",
       "tr": "On peut avancer que cela est bénéfique."
      }
     ]
    }
   ],
