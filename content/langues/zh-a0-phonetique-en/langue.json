   "grammar": [
    {
     "id": "zh-a0-phonetique-en-u2-g1",
     "title": "zh / ch / sh: curl the tongue",
     "md": "For **zh**, **ch**, **sh**, **curl the tongue** back (retroflex). **ch** adds a puff of air (aspirated), **sh** does not.",
     "examples": [
      {
       "text": "知 zhī",
       "tr": "to know"
      },
      {
       "text": "吃 chī",
       "tr": "to eat"
      }
     ]
    },
    {
     "id": "zh-a0-phonetique-en-u2-g2",
     "title": "x, q and the ü vowel",
     "md": "**x** and **q** are said with a flat tongue near the palate. The **ü** vowel (as in **鱼** yú, **绿** lǜ) rounds the lips; it is written **u** after y, j, q, x.",
     "examples": [
      {
       "text": "鱼 yú",
       "tr": "fish"
      },
      {
       "text": "绿 lǜ",
       "tr": "green"
      }
     ]
    }
   ],
