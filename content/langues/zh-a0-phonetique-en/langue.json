   "grammar": [
    {
     "id": "zh-a0-phonetique-en-u1-g1",
     "title": "Tone changes the meaning",
     "md": "Chinese is a **tonal** language: the same syllable **ma** changes meaning with pitch. Four tones plus a neutral one:\n- **1st** mā: high and flat (55)\n- **2nd** má: rising (35)\n- **3rd** mǎ: dips then rises (214)\n- **4th** mà: falling (51)\n- **neutral** ma: short, no contour.",
     "examples": [
      {
       "text": "妈 mā",
       "tr": "mom"
      },
      {
       "text": "马 mǎ",
       "tr": "horse"
      }
     ]
    }
   ],
