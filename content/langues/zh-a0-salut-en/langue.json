   "grammar": [
    {
     "id": "zh-a0-salut-en-g1",
     "title": "No conjugation, no articles",
     "md": "Chinese does not conjugate verbs and uses no articles. Word order is enough: **你好** (literally 'you good') means 'hello'. The same word works for everyone.",
     "examples": [
      {
       "text": "你好",
       "tr": "hello (literally: you good)"
      },
      {
       "text": "我很好",
       "tr": "I am very well (literally: I very good)"
      }
     ]
    },
    {
     "id": "zh-a0-salut-en-g2",
     "title": "The particle 吗 makes a question",
     "md": "Add **吗** (ma) at the end of a sentence to ask a yes/no question: **你好吗?** (how are you?). The answer repeats the key word: **好** (well).",
     "examples": [
      {
       "text": "你好吗？",
       "tr": "How are you?"
      }
     ]
    }
   ],
