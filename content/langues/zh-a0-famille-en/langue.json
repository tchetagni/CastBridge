     "id": "zh-a0-famille-en-d1",
     "title": "My family",
     "lines": [
      {
       "who": "A",
       "text": "这是我爸爸。",
       "reading": "zhè shì wǒ bàba.",
       "tr": "This is my dad."
      },
      {
       "who": "B",
       "text": "你好！",
       "reading": "nǐ hǎo!",
       "tr": "Hello!"
      },
      {
       "who": "A",
       "text": "这是我妈妈。",
       "reading": "zhè shì wǒ māma.",
       "tr": "This is my mom."
      },
      {
       "who": "B",
       "text": "你弟弟呢？",
       "reading": "nǐ dìdi ne?",
       "tr": "What about your little brother?"
      },
      {
       "who": "A",
       "text": "我弟弟很小。",
       "reading": "wǒ dìdi hěn xiǎo.",
       "tr": "My little brother is small."
      },
      {
       "who": "B",
       "text": "家很好！",
       "reading": "jiā hěn hǎo!",
       "tr": "Your family is nice!"
      }
     ],
     "audio": "m:zh-famille-d1"
    }
   ],
   "grammar": [
    {
     "id": "zh-a0-famille-en-g1",
     "title": "« 我 + noun » = my",
     "md": "Chinese has no word for 'my'. You just put **我** (I) before the noun: **我爸爸** (my dad), **我妈妈** (my mom).",
     "examples": [
      {
       "text": "我爸爸",
       "tr": "my dad"
      },
      {
       "text": "我妈妈",
       "tr": "my mom"
      }
     ]
    },
    {
     "id": "zh-a0-famille-en-g2",
     "title": "« 这是… » = this is…",
     "md": "**这是** (zhè shì) means 'this is': **这是我爸爸** (this is my dad).",
     "examples": [
      {
       "text": "这是我爸爸",
       "tr": "This is my dad"
      }
     ]
    }
   ],
