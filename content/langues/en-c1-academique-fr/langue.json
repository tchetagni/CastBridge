   "dialogues": [
    {
     "id": "en-c1-academique-fr-d1",
     "title": "Séminaire",
     "lines": [
      {
       "who": "A",
       "text": "What is the main hypothesis of this paper?",
       "tr": "Quelle est l'hypothèse principale de cet article ?"
      },
      {
       "who": "B",
       "text": "It argues that the evidence is not significant.",
       "tr": "Il soutient que la preuve n'est pas significative."
      },
      {
       "who": "A",
       "text": "Nevertheless, the methodology is relevant.",
       "tr": "Néanmoins, la méthodologie est pertinente."
      },
      {
       "who": "B",
       "text": "Furthermore, the analysis supports the conclusion.",
       "tr": "En outre, l'analyse appuie la conclusion."
      }
     ],
     "audio": "m:en-c1-academique-d1"
    }
   ],
   "grammar": [
    {
     "id": "en-c1-academique-fr-g1",
     "title": "La nominalisation académique",
     "md": "L'écrit universitaire transforme les verbes en noms : *to analyse* → *analysis*, *to conclude* → *conclusion*. Cela rend le style plus formel et dense.",
     "examples": [
      {
       "text": "The analysis of the data.",
       "tr": "L'analyse des données."
      }
     ]
    },
    {
     "id": "en-c1-academique-fr-g2",
     "title": "La voix passive",
     "md": "La **voix passive** est fréquente en contexte scientifique : *The experiment was conducted* (l'expérience a été menée).",
     "examples": [
      {
       "text": "The results were analysed.",
       "tr": "Les résultats ont été analysés."
      }
     ]
    }
   ],
