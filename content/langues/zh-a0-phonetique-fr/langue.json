   "grammar": [
    {
     "id": "zh-a0-phonetique-fr-u2-g1",
     "title": "zh / ch / sh : la langue se recourbe",
     "md": "Pour **zh**, **ch**, **sh**, on **recourbe la langue** vers l'arrière (rétroflexes). **ch** ajoute un souffle (aspiré), **sh** non.",
     "examples": [
      {
       "text": "知 zhī",
       "tr": "savoir"
      },
      {
       "text": "吃 chī",
       "tr": "manger"
      }
     ]
    },
    {
     "id": "zh-a0-phonetique-fr-u2-g2",
     "title": "x, q et la voyelle ü",
     "md": "**x** et **q** se disent langue plate, proche du palais. La voyelle **ü** (comme dans **鱼** yú, **绿** lǜ) arrondit les lèvres : on l'écrit **u** après y, j, q, x.",
     "examples": [
      {
       "text": "鱼 yú",
       "tr": "poisson"
      },
      {
       "text": "绿 lǜ",
       "tr": "vert"
      }
     ]
    }
