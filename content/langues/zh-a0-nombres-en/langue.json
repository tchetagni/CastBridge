      {
       "text": "一二三",
       "tr": "one, two, three"
      }
     ]
    },
    {
     "id": "zh-a0-nombres-en-g2",
     "title": "Age with 岁 (suì)",
     "md": "To say your age, add **岁** (suì) after the number: **我十岁** (I am ten, literally 'I ten years').",
     "examples": [
      {
       "text": "我十岁",
       "tr": "I am ten (years old)"
      }
     ]
    }
