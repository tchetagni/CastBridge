     "id": "ja-a0-famille-en-d1",
     "title": "My family",
     "lines": [
      {
       "who": "A",
       "text": "これは私のお父さんです。",
       "reading": "これはわたしのおとうさんです。",
       "tr": "This is my dad."
      },
      {
       "who": "B",
       "text": "こんにちは。",
       "reading": "こんにちは。",
       "tr": "Hello!"
      },
      {
       "who": "A",
       "text": "これは私のお母さんです。",
       "reading": "これはわたしのおかあさんです。",
       "tr": "This is my mom."
      },
      {
       "who": "B",
       "text": "弟さんは？",
       "reading": "おとうとさんは？",
       "tr": "What about your little brother?"
      },
      {
       "who": "A",
       "text": "弟は小さいです。",
       "reading": "おとうとはちいさいです。",
       "tr": "My little brother is small."
      },
      {
       "who": "B",
       "text": "いい家族です。",
       "reading": "いいかぞくです。",
       "tr": "Nice family!"
      }
     ],
     "audio": "m:ja-famille-d1"
    }
