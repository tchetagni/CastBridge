      },
      {
       "who": "A",
       "text": "これは私のお母さんです。",
       "reading": "これはわたしのおかあさんです。",
       "tr": "C'est ma maman."
      },
      {
       "who": "B",
       "text": "弟さんは？",
       "reading": "おとうとさんは？",
       "tr": "Et ton petit frère ?"
      },
