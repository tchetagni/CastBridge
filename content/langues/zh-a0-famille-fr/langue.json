   "dialogues": [
    {
     "id": "zh-a0-famille-fr-d1",
     "title": "Ma famille",
     "lines": [
      {
       "who": "A",
       "text": "这是我爸爸。",
       "reading": "zhè shì wǒ bàba.",
       "tr": "C'est mon papa."
      },
      {
       "who": "B",
       "text": "你好！",
       "reading": "nǐ hǎo!",
       "tr": "Bonjour !"
      },
      {
       "who": "A",
       "text": "这是我妈妈。",
       "reading": "zhè shì wǒ māma.",
       "tr": "C'est ma maman."
      },
      {
       "who": "B",
       "text": "你弟弟呢？",
       "reading": "nǐ dìdi ne?",
       "tr": "Et ton petit frère ?"
      },
      {
       "who": "A",
       "text": "我弟弟很小。",
       "reading": "wǒ dìdi hěn xiǎo.",
       "tr": "Mon petit frère est tout petit."
      },
      {
       "who": "B",
       "text": "家很好！",
       "reading": "jiā hěn hǎo!",
       "tr": "Ta famille est chouette !"
      }
     ],
     "audio": "m:zh-famille-d1"
    }
   ],
   "grammar": [
    {
     "id": "zh-a0-famille-fr-g1",
     "title": "« 我 + nom » = mon / mes",
     "md": "Le chinois n'a pas de mot pour « mon ». On place simplement **我** (je) devant le nom : **我爸爸** (mon papa), **我妈妈** (ma maman).",
     "examples": [
      {
       "text": "我爸爸",
       "tr": "mon papa"
      },
      {
       "text": "我妈妈",
       "tr": "ma maman"
      }
     ]
    },
    {
     "id": "zh-a0-famille-fr-g2",
     "title": "« 这是… » = c'est…",
     "md": "**这是** (zhè shì) signifie « c'est » : **这是我爸爸** (c'est mon papa).",
     "examples": [
      {
       "text": "这是我爸爸",
       "tr": "C'est mon papa"
      }
     ]
    }
   ],
