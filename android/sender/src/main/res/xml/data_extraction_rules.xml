<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (en plus de allowBackup=false) : mêmes exclusions pour la sauvegarde cloud et le transfert d'appareil ; elles doivent rester identiques à backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="castbridge_trust.xml" />
        <exclude domain="sharedpref" path="castbridge_pins.xml" />
        <exclude domain="sharedpref" path="castbridge_parental_inbox.xml" />
        <exclude domain="sharedpref" path="castbridge_parental_ledger.xml" />
        <exclude domain="file" path="owner-vault.txt" />
        <exclude domain="file" path="owner-journal.tsv" />
        <exclude domain="file" path="owner-bundles.json" />
        <exclude domain="sharedpref" path="owner_guard.xml" />
        <exclude domain="file" path="orders/" />
        <exclude domain="file" path="lots/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="castbridge_trust.xml" />
        <exclude domain="sharedpref" path="castbridge_pins.xml" />
        <exclude domain="sharedpref" path="castbridge_parental_inbox.xml" />
        <exclude domain="sharedpref" path="castbridge_parental_ledger.xml" />
        <exclude domain="file" path="owner-vault.txt" />
        <exclude domain="file" path="owner-journal.tsv" />
        <exclude domain="file" path="owner-bundles.json" />
        <exclude domain="sharedpref" path="owner_guard.xml" />
        <exclude domain="file" path="orders/" />
        <exclude domain="file" path="lots/" />
    </device-transfer>
</data-extraction-rules>
