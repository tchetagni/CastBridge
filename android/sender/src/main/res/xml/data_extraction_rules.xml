<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rule for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="castbridge_trust.xml" />
        <exclude domain="sharedpref" path="castbridge_parental_inbox.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="castbridge_trust.xml" />
        <exclude domain="sharedpref" path="castbridge_parental_inbox.xml" />
    </device-transfer>
</data-extraction-rules>
