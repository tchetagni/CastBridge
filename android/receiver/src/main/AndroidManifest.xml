<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Background service started with the TV (docs/ADMIN.md, "Démarrage avec la TV") -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Remote playback while the screen is closed: display over other apps (user grants it), or a full-screen notification -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- self-update over Wi-Fi: the TV installs an APK sent by the phone (the user still has to allow "install unknown apps" once) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Bluetooth file reception: install-time on API <= 30, runtime (BLUETOOTH_CONNECT/ADVERTISE) on 31+ -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- Wi-Fi Direct group: NEARBY_WIFI_DEVICES on 33+, fine location on 29-32 (runtime, opt-in from the MENU) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <!-- Downloads (aria2): keep downloading with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Supervision of the whole TV (docs/PARENTAL.md): special access « données d'utilisation » (the user grants it in Settings or with adb) to
         know which app is in front. Nothing is sent anywhere. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Android 11+ package visibility: only the apps with a launcher icon, the home launcher and the Settings screens are looked up -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.USAGE_ACCESS_SETTINGS" /></intent>
        <intent><action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="application/vnd.android.package-archive" /></intent>
    </queries>
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application
        android:name=".TvApp"
        android:label="CastBridge TV"
        android:banner="@drawable/banner"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/Theme.CastBridge.Tv">
        <activity
            android:name=".PlayerActivity"
            android:theme="@style/Theme.CastBridge.Tv.Splash"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".TvService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Quiz culture générale (docs/QUIZ.md): opened from the MENU or from the phone -->
        <activity
            android:name=".QuizActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation" />
        <!-- Échecs (docs/CHESS.md): opened from the home tile or from the phone -->
        <activity
            android:name=".ChessActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation" />
        <!-- Jeux (docs/GAMES.md): the games hub (home tile « Jeux ») and the Sudoku; no permission, no network -->
        <activity
            android:name=".GamesActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation" />
        <activity
            android:name=".SudokuActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation" />
        <!-- Apprendre (docs/LEARN.md): opened from the home tile or from the phone -->
        <activity
            android:name=".LearnActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation" />
        <!-- Server link (docs/TELEMETRY.md, docs/API-SERVER.md): information screen, updates, privacy, connection -->
        <activity android:name=".ServerActivity" android:exported="false" android:screenOrientation="landscape"
            android:launchMode="singleTop" android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.CastBridge.Tv.Screen" />
        <!-- « Ajouter un téléphone » (docs/BT-PLUG-AND-PLAY.md): pairing window, approval dialog, trusted phones. Not exported. -->
        <activity android:name=".PairActivity" android:exported="false" android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CastBridge.Tv.Screen" />
        <activity android:name=".DownloadsActivity" android:exported="false" android:screenOrientation="landscape"
            android:theme="@style/Theme.CastBridge.Tv.Screen" />
        <!-- Contrôle parental (docs/PARENTAL.md): settings screen and lock screen, both internal (not exported) -->
        <activity android:name=".ParentalActivity" android:exported="false" android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan" android:theme="@style/Theme.CastBridge.Tv.Screen" />
        <!-- « Surveillance de toute la TV » : guided setup (usage access, display over other apps, accessibility), internal -->
        <activity android:name=".SupervisionSetupActivity" android:exported="false" android:screenOrientation="landscape"
            android:launchMode="singleTop" android:theme="@style/Theme.CastBridge.Tv.Screen" />
        <activity android:name=".ParentalLockActivity" android:exported="false" android:screenOrientation="landscape"
            android:launchMode="singleTop" android:theme="@style/Theme.CastBridge.Tv.Screen" />
        <service android:name=".DownloadService" android:exported="false" android:foregroundServiceType="dataSync" />
        <!-- Phone remote (docs/REMOTE.md): help screen, and the OPTIONAL accessibility service the user may enable to pilot the
             whole TV. It acts only on orders of a phone that knows the TV's PIN; it reads and keeps nothing on its own. -->
        <activity android:name=".RemoteSetupActivity" android:exported="false" android:screenOrientation="landscape"
            android:theme="@style/Theme.CastBridge.Tv.Screen" />
        <service
            android:name=".RemoteAccessibilityService"
            android:exported="true"
            android:label="@string/remote_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/remote_accessibility" />
        </service>
    </application>
</manifest>
