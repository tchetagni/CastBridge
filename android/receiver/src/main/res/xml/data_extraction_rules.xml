<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rule for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="trusted_phones.txt" />
        <exclude domain="file" path="trusted_phones.txt.tmp" />
        <exclude domain="sharedpref" path="castbridge_parental_reports.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="trusted_phones.txt" />
        <exclude domain="file" path="trusted_phones.txt.tmp" />
        <exclude domain="sharedpref" path="castbridge_parental_reports.xml" />
    </device-transfer>
</data-extraction-rules>
