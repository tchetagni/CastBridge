<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_background"
    android:keepScreenOn="true">
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <!-- Home (media launcher), whole library (grid), connection & settings: built in code (HomeScreen, LibraryScreen, SettingsPanel) -->
    <FrameLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/library"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <!-- Barre d'état enroulable (StatusBarView) : le panneau déroulé (OK sur la pastille, accueil seulement) en haut à droite, par-dessus l'accueil ; enroulé par défaut.
         Jamais pris de focus pendant une vidéo. -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="88dp"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone" />
    <!-- La pastille de la barre enroulée : pire niveau + nombre, dans la bande d'en-tête à côté de l'horloge. -->
    <TextView
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="39dp"
        android:layout_marginEnd="144dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/lead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="64dp"
        android:background="#CC000000"
        android:padding="6dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />
</FrameLayout>
