<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_background"
    android:keepScreenOn="true">
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <!-- Home (media launcher), whole library (grid), connection & settings: built in code (HomeScreen, LibraryScreen, SettingsPanel) -->
    <FrameLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/library"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <!-- Barre d'icônes de statut (StatusBarView), toujours visible : colonne en haut à droite sous l'horloge, par-dessus l'accueil et la vidéo.
         Remplace les anciens badges séparés Internet / passerelle / SSH. Jamais prise de focus pendant une vidéo. -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="84dp"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone" />
    <TextView
        android:id="@+id/lead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="#99000000"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
