<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_quiz_en_ligne" targetNamespace="https://bridge.sti-cm.com/castbridge/architecture" exporter="CastBridge tools/architecture/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_quiz_en_ligne">
    <bpmn:documentation>Jouer au Quiz en ligne — Seule une TV activée et connectée à Internet, directement ou par le relais d'un téléphone synchronisé, joue en ligne ; les téléphones passent par leur TV (8 au plus, liaison de référence de 40 kbit/s). Pour une partie avec mise, la TV obtient de l'API un blocage `cbe1` signé (NDEM ou MBOKO, une mise par siège), puis un ticket `cbp1` (600 secondes, à usage unique), et ouvre la salle du service de jeu avec son activation `cbx1`. Le service contrôle le ticket, les droits, les plafonds et le blocage, ouvre la salle (code de 8 caractères, 2 heures) et enchaîne les questions : 1 à 2 secondes entre deux questions, horodatages du serveur. À la fin, le service signe le résultat `cbr1` ; la TV le poste à l'API (`/api/v1/wallet/settle`), qui crédite et débite le portefeuille en une transaction.</bpmn:documentation>
    <bpmn:participant id="Participant_phone" name="CastBridge (téléphone)" processRef="Process_phone" />
    <bpmn:participant id="Participant_tv" name="CastBridge-TV" processRef="Process_tv" />
    <bpmn:participant id="Participant_server" name="Serveur bridge.sti-cm.com" processRef="Process_server" />
    <bpmn:messageFlow id="MessageFlow_m_h_join__t_rel" name="join" sourceRef="SendTask_h_join" targetRef="Task_t_rel" />
    <bpmn:messageFlow id="MessageFlow_m_t_esc__a_esc" name="/wallet/escrow" sourceRef="ServiceTask_t_esc" targetRef="Task_a_esc" />
    <bpmn:messageFlow id="MessageFlow_m_a_esc__t_esc" name="cbe1" sourceRef="Task_a_esc" targetRef="ServiceTask_t_esc" />
    <bpmn:messageFlow id="MessageFlow_m_t_tk__a_tk" name="/play/ticket" sourceRef="ServiceTask_t_tk" targetRef="Task_a_tk" />
    <bpmn:messageFlow id="MessageFlow_m_a_tk__t_tk" name="cbp1" sourceRef="Task_a_tk" targetRef="ServiceTask_t_tk" />
    <bpmn:messageFlow id="MessageFlow_m_t_create__p_in" name="create" sourceRef="SendTask_t_create" targetRef="StartEvent_p_in" />
    <bpmn:messageFlow id="MessageFlow_m_p_ko__b_ko" name="Refus" sourceRef="EndEvent_p_ko" targetRef="BoundaryEvent_b_ko" />
    <bpmn:messageFlow id="MessageFlow_m_p_res__t_res" name="cbr1" sourceRef="EndEvent_p_res" targetRef="Event_t_res" />
    <bpmn:messageFlow id="MessageFlow_m_t_set__a_set" name="/wallet/settle" sourceRef="ServiceTask_t_set" targetRef="Task_a_set" />
    <bpmn:messageFlow id="MessageFlow_m_a_set__t_set" name="Solde" sourceRef="Task_a_set" targetRef="ServiceTask_t_set" />
  </bpmn:collaboration>
  <bpmn:process id="Process_phone" isExecutable="false">
    <bpmn:laneSet id="LaneSet_phone">
      <bpmn:lane id="Lane_h1" name="Joueur relayé par sa TV">
        <bpmn:flowNodeRef>StartEvent_h_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_h_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_h_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_h_start" name="Un joueur veut jouer en ligne">
      <bpmn:outgoing>Flow_h_start__h_join</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="SendTask_h_join" name="Rejoindre par la TV : code de salle">
      <bpmn:documentation>Page /quiz de la TV, jeton aléatoire de 128 bits par joueur ; aucun téléphone ne parle au service de jeu.</bpmn:documentation>
      <bpmn:incoming>Flow_h_start__h_join</bpmn:incoming>
      <bpmn:outgoing>Flow_h_join__h_end</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_h_end" name="Partie jouée par le relais de la TV">
      <bpmn:incoming>Flow_h_join__h_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_h_start__h_join" sourceRef="StartEvent_h_start" targetRef="SendTask_h_join" />
    <bpmn:sequenceFlow id="Flow_h_join__h_end" sourceRef="SendTask_h_join" targetRef="EndEvent_h_end" />
  </bpmn:process>
  <bpmn:process id="Process_tv" isExecutable="false">
    <bpmn:laneSet id="LaneSet_tv">
      <bpmn:lane id="Lane_t1" name="Hôte (Quiz, PlayHub, portefeuille)">
        <bpmn:flowNodeRef>StartEvent_t_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_t_chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_t_ref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_t_x</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_t_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_t_tk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_t_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_b_ko</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_t_rel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_t_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_t_set</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_t_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_t_in" name="Ouvrir Quiz › Partie Internet">
      <bpmn:outgoing>Flow_t_in__t_chk</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_t_chk" name="TV activée et en ligne (direct ou relais) ?" default="Flow_t_chk__t_x">
      <bpmn:incoming>Flow_t_in__t_chk</bpmn:incoming>
      <bpmn:outgoing>Flow_t_chk__t_x</bpmn:outgoing>
      <bpmn:outgoing>Flow_t_chk__t_ref</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_t_ref" name="Refus : activer la TV ou connecter Internet">
      <bpmn:incoming>Flow_t_chk__t_ref</bpmn:incoming>
      <bpmn:incoming>Flow_b_ko__t_ref</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_t_x" name="Partie avec mise ?" default="Flow_t_x__t_tk">
      <bpmn:incoming>Flow_t_chk__t_x</bpmn:incoming>
      <bpmn:outgoing>Flow_t_x__t_esc</bpmn:outgoing>
      <bpmn:outgoing>Flow_t_x__t_tk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_t_esc" name="Bloquer la mise : cbe1 (NDEM ou MBOKO)">
      <bpmn:documentation>Une mise par siège, de 1 à 8 sièges par TV ; une TV d'essai ne mise jamais.</bpmn:documentation>
      <bpmn:incoming>Flow_t_x__t_esc</bpmn:incoming>
      <bpmn:outgoing>Flow_t_esc__t_tk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_t_tk" name="Demander le ticket cbp1 (600 s)">
      <bpmn:documentation>Usage unique (jti), signé Ed25519 par l'API ; l'API en redonne 20 par heure et par appareil.</bpmn:documentation>
      <bpmn:incoming>Flow_t_x__t_tk</bpmn:incoming>
      <bpmn:incoming>Flow_t_esc__t_tk</bpmn:incoming>
      <bpmn:outgoing>Flow_t_tk__t_create</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendTask_t_create" name="create : ticket, activation cbx1, preuve">
      <bpmn:documentation>Ticket, activation cbx1 et preuve de possession de la clé d'installation (PLAY-PROTOCOL § Ticket et droits).</bpmn:documentation>
      <bpmn:incoming>Flow_t_tk__t_create</bpmn:incoming>
      <bpmn:outgoing>Flow_t_create__t_rel</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="BoundaryEvent_b_ko" name="Refus du service" cancelActivity="true" attachedToRef="SendTask_t_create">
      <bpmn:outgoing>Flow_b_ko__t_ref</bpmn:outgoing>
      <bpmn:messageEventDefinition id="BoundaryEvent_b_ko_def" />
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_t_rel" name="Relayer les téléphones : 8 au plus">
      <bpmn:documentation>relayJoin et relayAct ; fenêtre de réponse allongée de la latence mesurée, bornée à 1 s ; 40 kbit/s.</bpmn:documentation>
      <bpmn:incoming>Flow_t_create__t_rel</bpmn:incoming>
      <bpmn:outgoing>Flow_t_rel__t_res</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_t_res" name="Résultat cbr1 signé reçu">
      <bpmn:incoming>Flow_t_rel__t_res</bpmn:incoming>
      <bpmn:outgoing>Flow_t_res__t_set</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_t_res_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ServiceTask_t_set" name="Régler : POST /api/v1/wallet/settle (cbr1)">
      <bpmn:incoming>Flow_t_res__t_set</bpmn:incoming>
      <bpmn:outgoing>Flow_t_set__t_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_t_end" name="Solde mis à jour (cbw1)">
      <bpmn:incoming>Flow_t_set__t_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_t_in__t_chk" sourceRef="StartEvent_t_in" targetRef="Gateway_t_chk" />
    <bpmn:sequenceFlow id="Flow_t_chk__t_x" name="Oui" sourceRef="Gateway_t_chk" targetRef="Gateway_t_x" />
    <bpmn:sequenceFlow id="Flow_t_chk__t_ref" name="Non" sourceRef="Gateway_t_chk" targetRef="EndEvent_t_ref" />
    <bpmn:sequenceFlow id="Flow_t_x__t_esc" name="Oui" sourceRef="Gateway_t_x" targetRef="ServiceTask_t_esc" />
    <bpmn:sequenceFlow id="Flow_t_x__t_tk" name="Non" sourceRef="Gateway_t_x" targetRef="ServiceTask_t_tk" />
    <bpmn:sequenceFlow id="Flow_t_esc__t_tk" sourceRef="ServiceTask_t_esc" targetRef="ServiceTask_t_tk" />
    <bpmn:sequenceFlow id="Flow_t_tk__t_create" sourceRef="ServiceTask_t_tk" targetRef="SendTask_t_create" />
    <bpmn:sequenceFlow id="Flow_t_create__t_rel" sourceRef="SendTask_t_create" targetRef="Task_t_rel" />
    <bpmn:sequenceFlow id="Flow_b_ko__t_ref" sourceRef="BoundaryEvent_b_ko" targetRef="EndEvent_t_ref" />
    <bpmn:sequenceFlow id="Flow_t_rel__t_res" sourceRef="Task_t_rel" targetRef="Event_t_res" />
    <bpmn:sequenceFlow id="Flow_t_res__t_set" sourceRef="Event_t_res" targetRef="ServiceTask_t_set" />
    <bpmn:sequenceFlow id="Flow_t_set__t_end" sourceRef="ServiceTask_t_set" targetRef="EndEvent_t_end" />
  </bpmn:process>
  <bpmn:process id="Process_server" isExecutable="false">
    <bpmn:laneSet id="LaneSet_server">
      <bpmn:lane id="Lane_a1" name="castbridge-api (ticket, portefeuille)">
        <bpmn:flowNodeRef>StartEvent_a_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_a_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_a_tk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_a_set</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_a_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_s1" name="castbridge-play (salle de jeu)">
        <bpmn:flowNodeRef>StartEvent_p_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_p_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_p_ko</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_p_room</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_p_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_p_ans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_p_more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_p_settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_p_res</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_a_start" name="API principale disponible">
      <bpmn:outgoing>Flow_a_start__a_esc</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_a_esc" name="Bloquer la mise au grand livre, signer cbe1">
      <bpmn:incoming>Flow_a_start__a_esc</bpmn:incoming>
      <bpmn:outgoing>Flow_a_esc__a_tk</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_a_tk" name="Émettre le ticket cbp1 (Ed25519, jti)">
      <bpmn:incoming>Flow_a_esc__a_tk</bpmn:incoming>
      <bpmn:outgoing>Flow_a_tk__a_set</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_a_set" name="Régler : crédit et débit en une transaction">
      <bpmn:documentation>Idempotent : un seul résultat par salle (rid = SHA-256 de la salle).</bpmn:documentation>
      <bpmn:incoming>Flow_a_tk__a_set</bpmn:incoming>
      <bpmn:outgoing>Flow_a_set__a_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_a_end" name="Solde signé cbw1">
      <bpmn:incoming>Flow_a_set__a_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_p_in" name="create ou join reçu">
      <bpmn:outgoing>Flow_p_in__p_gate</bpmn:outgoing>
      <bpmn:messageEventDefinition id="StartEvent_p_in_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_p_gate" name="Ticket, droits, plafonds, blocage valides ?" default="Flow_p_gate__p_room">
      <bpmn:incoming>Flow_p_in__p_gate</bpmn:incoming>
      <bpmn:outgoing>Flow_p_gate__p_room</bpmn:outgoing>
      <bpmn:outgoing>Flow_p_gate__p_ko</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_p_ko" name="Refuser : PLAY_TICKET_REFUSED, SCOPE_FORBIDDEN…">
      <bpmn:incoming>Flow_p_gate__p_ko</bpmn:incoming>
      <bpmn:messageEventDefinition id="EndEvent_p_ko_def" />
    </bpmn:endEvent>
    <bpmn:task id="Task_p_room" name="Ouvrir la salle : code XXXX-XXXX (2 h)">
      <bpmn:documentation>8 joueurs au plus par table, 8 sièges relayés au plus par TV ; 50 essais faux changent le code.</bpmn:documentation>
      <bpmn:incoming>Flow_p_gate__p_room</bpmn:incoming>
      <bpmn:outgoing>Flow_p_room__p_q</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_p_q" name="Annoncer la question : ouverture après 1,5 s">
      <bpmn:documentation>PlayTiming : opensAtServerMs = révélation + délai de 1 à 2 s ; une réponse avant est refusée (TOO_EARLY).</bpmn:documentation>
      <bpmn:incoming>Flow_p_room__p_q</bpmn:incoming>
      <bpmn:incoming>Flow_p_more__p_q</bpmn:incoming>
      <bpmn:outgoing>Flow_p_q__p_ans</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_p_ans" name="Recevoir les réponses, révéler, scorer">
      <bpmn:incoming>Flow_p_q__p_ans</bpmn:incoming>
      <bpmn:outgoing>Flow_p_ans__p_more</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_p_more" name="Dernière question ?" default="Flow_p_more__p_settle">
      <bpmn:incoming>Flow_p_ans__p_more</bpmn:incoming>
      <bpmn:outgoing>Flow_p_more__p_q</bpmn:outgoing>
      <bpmn:outgoing>Flow_p_more__p_settle</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_p_settle" name="Règlement : cagnotte partagée">
      <bpmn:documentation>QuizSettlement : 1 joueur 100 % ; 2 joueurs 70/30 ; 3 et plus 60/30/10 ; personne n'a marqué : chacun reprend sa mise.</bpmn:documentation>
      <bpmn:incoming>Flow_p_more__p_settle</bpmn:incoming>
      <bpmn:outgoing>Flow_p_settle__p_res</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_p_res" name="Résultat cbr1 signé">
      <bpmn:incoming>Flow_p_settle__p_res</bpmn:incoming>
      <bpmn:messageEventDefinition id="EndEvent_p_res_def" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_a_start__a_esc" sourceRef="StartEvent_a_start" targetRef="Task_a_esc" />
    <bpmn:sequenceFlow id="Flow_a_esc__a_tk" sourceRef="Task_a_esc" targetRef="Task_a_tk" />
    <bpmn:sequenceFlow id="Flow_a_tk__a_set" sourceRef="Task_a_tk" targetRef="Task_a_set" />
    <bpmn:sequenceFlow id="Flow_a_set__a_end" sourceRef="Task_a_set" targetRef="EndEvent_a_end" />
    <bpmn:sequenceFlow id="Flow_p_in__p_gate" sourceRef="StartEvent_p_in" targetRef="Gateway_p_gate" />
    <bpmn:sequenceFlow id="Flow_p_gate__p_room" name="Oui" sourceRef="Gateway_p_gate" targetRef="Task_p_room" />
    <bpmn:sequenceFlow id="Flow_p_gate__p_ko" name="Non" sourceRef="Gateway_p_gate" targetRef="EndEvent_p_ko" />
    <bpmn:sequenceFlow id="Flow_p_room__p_q" sourceRef="Task_p_room" targetRef="Task_p_q" />
    <bpmn:sequenceFlow id="Flow_p_q__p_ans" sourceRef="Task_p_q" targetRef="Task_p_ans" />
    <bpmn:sequenceFlow id="Flow_p_ans__p_more" sourceRef="Task_p_ans" targetRef="Gateway_p_more" />
    <bpmn:sequenceFlow id="Flow_p_more__p_q" name="Non" sourceRef="Gateway_p_more" targetRef="Task_p_q" />
    <bpmn:sequenceFlow id="Flow_p_more__p_settle" name="Oui" sourceRef="Gateway_p_more" targetRef="Task_p_settle" />
    <bpmn:sequenceFlow id="Flow_p_settle__p_res" sourceRef="Task_p_settle" targetRef="EndEvent_p_res" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_quiz_en_ligne">
    <bpmndi:BPMNPlane id="BPMNPlane_quiz_en_ligne" bpmnElement="Collaboration_quiz_en_ligne">
      <bpmndi:BPMNShape id="Participant_phone_di" bpmnElement="Participant_phone" isHorizontal="true">
        <dc:Bounds x="10" y="20" width="2910" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_h1_di" bpmnElement="Lane_h1" isHorizontal="true">
        <dc:Bounds x="40" y="20" width="2880" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_tv_di" bpmnElement="Participant_tv" isHorizontal="true">
        <dc:Bounds x="10" y="224" width="2910" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_t1_di" bpmnElement="Lane_t1" isHorizontal="true">
        <dc:Bounds x="40" y="224" width="2880" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_server_di" bpmnElement="Participant_server" isHorizontal="true">
        <dc:Bounds x="10" y="776" width="2910" height="425" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_a1_di" bpmnElement="Lane_a1" isHorizontal="true">
        <dc:Bounds x="40" y="776" width="2880" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_s1_di" bpmnElement="Lane_s1" isHorizontal="true">
        <dc:Bounds x="40" y="926" width="2880" height="275" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_h_start_di" bpmnElement="StartEvent_h_start" bioc:stroke="#0A6A4B" bioc:fill="#FFFFFF">
        <dc:Bounds x="117" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="98" y="116" width="74" height="29" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask_h_join_di" bpmnElement="SendTask_h_join" bioc:stroke="#0A6A4B" bioc:fill="#D3ECE1">
        <dc:Bounds x="270" y="55" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_h_end_di" bpmnElement="EndEvent_h_end" bioc:stroke="#0A6A4B" bioc:fill="#FFFFFF">
        <dc:Bounds x="497" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="469" y="116" width="92" height="29" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_t_in_di" bpmnElement="StartEvent_t_in" bioc:stroke="#885600" bioc:fill="#FFFFFF">
        <dc:Bounds x="117" y="281" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="99" y="320" width="72" height="29" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_t_chk_di" bpmnElement="Gateway_t_chk" isMarkerVisible="true" bioc:stroke="#885600" bioc:fill="#FFFFFF">
        <dc:Bounds x="300" y="274" width="50" height="50" />
        <bpmndi:BPMNLabel>
