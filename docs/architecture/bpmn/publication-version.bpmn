<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_publication_version" targetNamespace="https://bridge.sti-cm.com/castbridge/architecture" exporter="CastBridge tools/architecture/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_publication_version">
    <bpmn:documentation>Publier une version — Une livraison suit toujours le même chemin : `check_versions.py` contrôle `version.properties` (SemVer, `versionCode` strictement croissant, variante verrouillée de la TV avec code + 1 et suffixe `-verrouillee`). La TV est construite verrouillée (`-PrequireActivation=true`, clés de confiance hors dépôt) et le téléphone en deux variantes, simple et superadmin. Chaque APK est aligné (`zipalign`), signé (`apksigner`, `release.jks`, certificat `ef2908…`) et reçoit sa somme `SHA256SUMS`. Les APK sont déposés dans le dossier Download de la TV par SSH, sur la clé USB de distribution (jamais la variante superadmin), puis sur le téléphone du propriétaire par ADB avec l'installation de la console. Les documents (`CHANGELOG`, `RELEASES` § 9, `REGRESSIONS`, `HANDOFF`) et le guide sont mis à jour, le guide est copié sur le serveur (`/guide/`) et republié sur la page claude.ai. Les étiquettes suivent ; le push, la fusion d'`integration/agents` et l'avance de `main` sont des décisions du propriétaire.</bpmn:documentation>
    <bpmn:participant id="Participant_owner" name="Utilisateur / Propriétaire" processRef="Process_owner" />
    <bpmn:participant id="Participant_mac" name="Mac d'assistance" processRef="Process_mac" />
    <bpmn:participant id="Participant_tv" name="CastBridge-TV" processRef="Process_tv" />
    <bpmn:participant id="Participant_usb" name="Clé USB" processRef="Process_usb" />
    <bpmn:participant id="Participant_phone" name="CastBridge (téléphone)" processRef="Process_phone" />
    <bpmn:participant id="Participant_server" name="Serveur bridge.sti-cm.com" processRef="Process_server" />
    <bpmn:messageFlow id="MessageFlow_m_o_go__m_in" name="Livraison" sourceRef="SendTask_o_go" targetRef="StartEvent_m_in" />
    <bpmn:messageFlow id="MessageFlow_m_m_dtv__t_in" name="SSH" sourceRef="SendTask_m_dtv" targetRef="StartEvent_t_in" />
    <bpmn:messageFlow id="MessageFlow_m_m_dusb__k_in" name="Copie" sourceRef="SendTask_m_dusb" targetRef="StartEvent_k_in" />
    <bpmn:messageFlow id="MessageFlow_m_m_dph__p_in" name="ADB" sourceRef="SendTask_m_dph" targetRef="StartEvent_p_in" />
    <bpmn:messageFlow id="MessageFlow_m_m_srv__v_in" name="scp" sourceRef="SendTask_m_srv" targetRef="StartEvent_v_in" />
    <bpmn:messageFlow id="MessageFlow_m_m_ask__o_dec" name="Décision" sourceRef="EndEvent_m_ask" targetRef="UserTask_o_dec" />
  </bpmn:collaboration>
  <bpmn:process id="Process_owner" isExecutable="false">
    <bpmn:laneSet id="LaneSet_owner">
      <bpmn:lane id="Lane_o1" name="Propriétaire">
        <bpmn:flowNodeRef>StartEvent_o_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_o_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_o_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_o_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_o_start" name="Version décidée">
      <bpmn:outgoing>Flow_o_start__o_go</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="SendTask_o_go" name="Lancer la livraison (version.properties à jour)">
      <bpmn:incoming>Flow_o_start__o_go</bpmn:incoming>
      <bpmn:outgoing>Flow_o_go__o_dec</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask_o_dec" name="Décider : push, fusion, avance de main">
      <bpmn:documentation>Fusion d'integration/agents puis avance rapide de main : décision du propriétaire (docs/coordination/VERSIONING-DEVOPS-2026-10-02.md).</bpmn:documentation>
      <bpmn:incoming>Flow_o_go__o_dec</bpmn:incoming>
      <bpmn:outgoing>Flow_o_dec__o_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_o_end" name="Version publiée">
      <bpmn:incoming>Flow_o_dec__o_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_o_start__o_go" sourceRef="StartEvent_o_start" targetRef="SendTask_o_go" />
    <bpmn:sequenceFlow id="Flow_o_go__o_dec" sourceRef="SendTask_o_go" targetRef="UserTask_o_dec" />
    <bpmn:sequenceFlow id="Flow_o_dec__o_end" sourceRef="UserTask_o_dec" targetRef="EndEvent_o_end" />
  </bpmn:process>
  <bpmn:process id="Process_mac" isExecutable="false">
    <bpmn:laneSet id="LaneSet_mac">
      <bpmn:lane id="Lane_m1" name="Contrôles et build">
        <bpmn:flowNodeRef>StartEvent_m_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_m_chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_m_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_m_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_m_bt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_m_bp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_m2" name="Signature et dépôts">
        <bpmn:flowNodeRef>Task_m_sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_m_dtv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_m_dusb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_m_dph</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_m3" name="Docs et étiquettes">
        <bpmn:flowNodeRef>Task_m_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_m_guide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_m_srv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_m_page</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_m_tag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_m_ask</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_m_in" name="Livraison demandée">
      <bpmn:outgoing>Flow_m_in__m_chk</bpmn:outgoing>
      <bpmn:messageEventDefinition id="StartEvent_m_in_def" />
    </bpmn:startEvent>
    <bpmn:task id="Task_m_chk" name="check_versions.py">
      <bpmn:documentation>Forme, SemVer, versionCode croissant, variante verrouillée (code + 1, suffixe -verrouillee), état git, cohérence avec backend/pom.xml.</bpmn:documentation>
      <bpmn:incoming>Flow_m_in__m_chk</bpmn:incoming>
      <bpmn:outgoing>Flow_m_chk__m_ok</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_m_ok" name="Contrôle sans erreur ?" default="Flow_m_ok__m_bt">
      <bpmn:incoming>Flow_m_chk__m_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_m_ok__m_bt</bpmn:outgoing>
      <bpmn:outgoing>Flow_m_ok__m_stop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_m_stop" name="Corriger les versions et recommencer">
      <bpmn:incoming>Flow_m_ok__m_stop</bpmn:incoming>
      <bpmn:errorEventDefinition id="EndEvent_m_stop_def" />
    </bpmn:endEvent>
    <bpmn:task id="Task_m_bt" name="Construire la TV verrouillée (-PrequireActivation=true)">
      <bpmn:documentation>Avec -PtrustedKeysFile=~/.castbridge-signing/activation-trusted-keys.txt ; plus de variante déverrouillée.</bpmn:documentation>
      <bpmn:incoming>Flow_m_ok__m_bt</bpmn:incoming>
      <bpmn:outgoing>Flow_m_bt__m_bp</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_m_bp" name="Construire le téléphone : simple et superadmin">
      <bpmn:incoming>Flow_m_bt__m_bp</bpmn:incoming>
      <bpmn:outgoing>Flow_m_bp__m_sign</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_m_sign" name="zipalign, apksigner (release.jks), SHA256SUMS">
      <bpmn:documentation>apksigner sign --ks release.jks --ks-pass file:… ; certificat ef2908… vérifié ; check_versions.py --apk compare chaque APK à version.properties.</bpmn:documentation>
      <bpmn:incoming>Flow_m_bp__m_sign</bpmn:incoming>
      <bpmn:outgoing>Flow_m_sign__m_dtv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="SendTask_m_dtv" name="Copier dans Download de la TV (SSH)">
      <bpmn:documentation>CastBridge Dev, port 2223 ; vérifier la taille et le SHA-256 des deux côtés.</bpmn:documentation>
      <bpmn:incoming>Flow_m_sign__m_dtv</bpmn:incoming>
      <bpmn:outgoing>Flow_m_dtv__m_dusb</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask_m_dusb" name="Copier sur la clé USB avec SHA256SUMS.txt">
      <bpmn:documentation>Les dernières versions seulement : TV verrouillée et téléphone simple, jamais la variante superadmin ; éjecter la clé avant de la retirer.</bpmn:documentation>
      <bpmn:incoming>Flow_m_dtv__m_dusb</bpmn:incoming>
      <bpmn:outgoing>Flow_m_dusb__m_dph</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask_m_dph" name="adb install -r de la console, adb push des APK">
      <bpmn:documentation>Les trois APK signés et SHA256SUMS dans /sdcard/Download, vérifiés par sha256sum -c sur l'appareil.</bpmn:documentation>
      <bpmn:incoming>Flow_m_dusb__m_dph</bpmn:incoming>
      <bpmn:outgoing>Flow_m_dph__m_docs</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_m_docs" name="CHANGELOG, RELEASES § 9, REGRESSIONS, HANDOFF">
      <bpmn:incoming>Flow_m_dph__m_docs</bpmn:incoming>
      <bpmn:outgoing>Flow_m_docs__m_guide</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_m_guide" name="build_guide.py : guide HTML régénéré">
      <bpmn:incoming>Flow_m_docs__m_guide</bpmn:incoming>
      <bpmn:outgoing>Flow_m_guide__m_srv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="SendTask_m_srv" name="scp et docker cp vers /guide/">
      <bpmn:incoming>Flow_m_guide__m_srv</bpmn:incoming>
      <bpmn:outgoing>Flow_m_srv__m_page</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_m_page" name="Republier la page claude.ai du guide">
      <bpmn:incoming>Flow_m_srv__m_page</bpmn:incoming>
      <bpmn:outgoing>Flow_m_page__m_tag</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_m_tag" name="Étiquettes tv-, phone-, tvweb-">
      <bpmn:incoming>Flow_m_page__m_tag</bpmn:incoming>
      <bpmn:outgoing>Flow_m_tag__m_ask</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_m_ask" name="Proposer le push et la fusion">
      <bpmn:incoming>Flow_m_tag__m_ask</bpmn:incoming>
      <bpmn:messageEventDefinition id="EndEvent_m_ask_def" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_m_in__m_chk" sourceRef="StartEvent_m_in" targetRef="Task_m_chk" />
    <bpmn:sequenceFlow id="Flow_m_chk__m_ok" sourceRef="Task_m_chk" targetRef="Gateway_m_ok" />
    <bpmn:sequenceFlow id="Flow_m_ok__m_bt" name="Oui" sourceRef="Gateway_m_ok" targetRef="Task_m_bt" />
    <bpmn:sequenceFlow id="Flow_m_ok__m_stop" name="Non" sourceRef="Gateway_m_ok" targetRef="EndEvent_m_stop" />
    <bpmn:sequenceFlow id="Flow_m_bt__m_bp" sourceRef="Task_m_bt" targetRef="Task_m_bp" />
    <bpmn:sequenceFlow id="Flow_m_bp__m_sign" sourceRef="Task_m_bp" targetRef="Task_m_sign" />
    <bpmn:sequenceFlow id="Flow_m_sign__m_dtv" sourceRef="Task_m_sign" targetRef="SendTask_m_dtv" />
    <bpmn:sequenceFlow id="Flow_m_dtv__m_dusb" sourceRef="SendTask_m_dtv" targetRef="SendTask_m_dusb" />
    <bpmn:sequenceFlow id="Flow_m_dusb__m_dph" sourceRef="SendTask_m_dusb" targetRef="SendTask_m_dph" />
    <bpmn:sequenceFlow id="Flow_m_dph__m_docs" sourceRef="SendTask_m_dph" targetRef="Task_m_docs" />
    <bpmn:sequenceFlow id="Flow_m_docs__m_guide" sourceRef="Task_m_docs" targetRef="Task_m_guide" />
    <bpmn:sequenceFlow id="Flow_m_guide__m_srv" sourceRef="Task_m_guide" targetRef="SendTask_m_srv" />
    <bpmn:sequenceFlow id="Flow_m_srv__m_page" sourceRef="SendTask_m_srv" targetRef="Task_m_page" />
    <bpmn:sequenceFlow id="Flow_m_page__m_tag" sourceRef="Task_m_page" targetRef="Task_m_tag" />
    <bpmn:sequenceFlow id="Flow_m_tag__m_ask" sourceRef="Task_m_tag" targetRef="EndEvent_m_ask" />
  </bpmn:process>
  <bpmn:process id="Process_tv" isExecutable="false">
    <bpmn:laneSet id="LaneSet_tv">
      <bpmn:lane id="Lane_t1" name="Dossier Download">
        <bpmn:flowNodeRef>StartEvent_t_in</bpmn:flowNodeRef>
