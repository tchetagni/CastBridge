    <bpmn:sequenceFlow id="Flow_t_in__t_end" sourceRef="StartEvent_t_in" targetRef="EndEvent_t_end" />
  </bpmn:process>
  <bpmn:process id="Process_usb" isExecutable="false">
    <bpmn:laneSet id="LaneSet_usb">
      <bpmn:lane id="Lane_k1" name="Clé de distribution">
        <bpmn:flowNodeRef>StartEvent_k_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_k_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_k_in" name="APK et sommes copiés">
      <bpmn:outgoing>Flow_k_in__k_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="StartEvent_k_in_def" />
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_k_end" name="Clé prête : l'éjecter avant de la retirer">
      <bpmn:incoming>Flow_k_in__k_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_k_in__k_end" sourceRef="StartEvent_k_in" targetRef="EndEvent_k_end" />
  </bpmn:process>
  <bpmn:process id="Process_phone" isExecutable="false">
    <bpmn:laneSet id="LaneSet_phone">
      <bpmn:lane id="Lane_p1" name="Téléphone (ADB)">
        <bpmn:flowNodeRef>StartEvent_p_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_p_inst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_p_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_p_in" name="APK poussés par ADB">
      <bpmn:outgoing>Flow_p_in__p_inst</bpmn:outgoing>
      <bpmn:messageEventDefinition id="StartEvent_p_in_def" />
    </bpmn:startEvent>
    <bpmn:task id="Task_p_inst" name="Installer la console par-dessus, contrôler les sommes">
      <bpmn:incoming>Flow_p_in__p_inst</bpmn:incoming>
