    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p_in__p_inst" sourceRef="StartEvent_p_in" targetRef="Task_p_inst" />
    <bpmn:sequenceFlow id="Flow_p_inst__p_end" sourceRef="Task_p_inst" targetRef="EndEvent_p_end" />
  </bpmn:process>
  <bpmn:process id="Process_server" isExecutable="false">
    <bpmn:laneSet id="LaneSet_server">
      <bpmn:lane id="Lane_v1" name="Guide public">
        <bpmn:flowNodeRef>StartEvent_v_in</bpmn:flowNodeRef>
