      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_v_in" name="Guide reçu">
      <bpmn:outgoing>Flow_v_in__v_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="StartEvent_v_in_def" />
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_v_end" name="Guide servi sur /guide/">
      <bpmn:incoming>Flow_v_in__v_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_v_in__v_end" sourceRef="StartEvent_v_in" targetRef="EndEvent_v_end" />
  </bpmn:process>
