def panel(flowable, bg=None, pad=5, width=None):
    t = Table([[flowable]], colWidths=[width or W])
    st = [("ALIGN", (0, 0), (-1, -1), "CENTER"), ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
          ("TOPPADDING", (0, 0), (-1, -1), pad), ("BOTTOMPADDING", (0, 0), (-1, -1), pad)]
    if bg:
        st += [("BACKGROUND", (0, 0), (-1, -1), bg), ("BOX", (0, 0), (-1, -1), 0.4, col("#B9C2D4"))]
    t.setStyle(TableStyle(st))
    return t


def table(rows, widths, head=True, extra=None):
    t = Table(rows, colWidths=widths, repeatRows=1 if head else 0)
    st = [("VALIGN", (0, 0), (-1, -1), "MIDDLE"), ("TOPPADDING", (0, 0), (-1, -1), 3), ("BOTTOMPADDING", (0, 0), (-1, -1), 3),
          ("LINEBELOW", (0, 0), (-1, -1), 0.3, LINE)] + (extra or [])
    t.setStyle(TableStyle(st))
    return t


def swatches(rows):
    data, st = [], []
    for i, (label, path, use) in enumerate(rows):
        h = hexv(path)
        data.append(["", P(label, "cellb"), P(h, "cell"), P(use, "small")])
        st += [("BACKGROUND", (0, i), (0, i), col(h)), ("BOX", (0, i), (0, i), 0.3, col("#B9C2D4"))]
    return table(data, [11 * mm, 38 * mm, 24 * mm, None], head=False, extra=st)


