_n = [0]


def raster(svg_path_or_text, width_px, bg=None, recolor=None):
    """SVG -> PNG (largeur imposée, proportions conservées)."""
    _n[0] += 1
    src = os.path.join(TMP, f"s{_n[0]}.svg")
    text = svg_path_or_text if svg_path_or_text.lstrip().startswith("<") else open(svg_path_or_text, encoding="utf-8").read()
    if recolor:
        text = text.replace("currentColor", recolor)
    open(src, "w", encoding="utf-8").write(text)
    out = os.path.join(TMP, f"r{_n[0]}.png")
    cmd = ["rsvg-convert", "-w", str(width_px)] + (["-b", bg] if bg else []) + [src, "-o", out]
    subprocess.run(cmd, check=True)
    return out


def pic(path, width_mm=None, height_mm=None):
    iw, ih = ImageReader(path).getSize()
    if width_mm:
        return Image(path, width=width_mm * mm, height=width_mm * mm * ih / iw)
    return Image(path, width=height_mm * mm * iw / ih, height=height_mm * mm)


def logo(name, width_mm, bg=None):
    return pic(raster(os.path.join(BR, "logo", name + ".svg"), int(width_mm * 14)), width_mm)


def panel(flowable, bg=None, pad=5, width=None):
    t = Table([[flowable]], colWidths=[width or W])
    st = [("ALIGN", (0, 0), (-1, -1), "CENTER"), ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
          ("TOPPADDING", (0, 0), (-1, -1), pad), ("BOTTOMPADDING", (0, 0), (-1, -1), pad)]
    if bg:
        st += [("BACKGROUND", (0, 0), (-1, -1), bg), ("BOX", (0, 0), (-1, -1), 0.4, col("#B9C2D4"))]
    t.setStyle(TableStyle(st))
    return t


def table(rows, widths, head=True, extra=None):
    t = Table(rows, colWidths=widths, repeatRows=1 if head else 0)
    st = [("VALIGN", (0, 0), (-1, -1), "MIDDLE"), ("TOPPADDING", (0, 0), (-1, -1), 3), ("BOTTOMPADDING", (0, 0), (-1, -1), 3),
          ("LINEBELOW", (0, 0), (-1, -1), 0.3, LINE)] + (extra or [])
    t.setStyle(TableStyle(st))
    return t


def swatches(rows):
    data, st = [], []
    for i, (label, path, use) in enumerate(rows):
        h = hexv(path)
        data.append(["", P(label, "cellb"), P(h, "cell"), P(use, "small")])
        st += [("BACKGROUND", (0, i), (0, i), col(h)), ("BOX", (0, i), (0, i), 0.3, col("#B9C2D4"))]
    return table(data, [11 * mm, 38 * mm, 24 * mm, None], head=False, extra=st)


