def construction_svg():
    """Le symbole en construction : zone de dégagement minimale (6 unités) et dégagements mesurés (11 / 11 / 10)."""
    m = MARK
    poly = m.placed("full")
    join = m.DETAIL["full"][1]
    pts = " ".join(f"{x:.2f},{y:.2f}" for x, y in poly)
    l, r, a = m.clearances(poly, join)
    # points les plus proches : écouteur gauche / droit / arc (échantillonnage, mêmes formules que gen_cameroun_mark.clearances)
    samples = []
    for i in range(len(poly)):
        p0, p1 = poly[i], poly[(i + 1) % len(poly)]
        samples += [(p0[0] + (p1[0] - p0[0]) * t / 20, p0[1] + (p1[1] - p0[1]) * t / 20) for t in range(20)]

    def nearest_rect(p, rc):
        x, y, w, h = rc
        return (min(max(p[0], x), x + w), min(max(p[1], y), y + h))
    arcpts = [((1 - t) ** 2 * m.ARC[0][0] + 2 * t * (1 - t) * m.ARC[1][0] + t * t * m.ARC[2][0],
               (1 - t) ** 2 * m.ARC[0][1] + 2 * t * (1 - t) * m.ARC[1][1] + t * t * m.ARC[2][1]) for t in [i / 200 for i in range(201)]]
    pl = min(samples, key=lambda p: math.hypot(p[0] - nearest_rect(p, m.LEFT_EAR)[0], p[1] - nearest_rect(p, m.LEFT_EAR)[1]))
    pr = min(samples, key=lambda p: math.hypot(p[0] - nearest_rect(p, m.RIGHT_EAR)[0], p[1] - nearest_rect(p, m.RIGHT_EAR)[1]))
    pa, qa = min(((p, q) for p in samples[::3] for q in arcpts[::2]), key=lambda t: math.hypot(t[0][0] - t[1][0], t[0][1] - t[1][1]))
    el, er = nearest_rect(pl, m.LEFT_EAR), nearest_rect(pr, m.RIGHT_EAR)

    def dim(p, q, label, dx=0, dy=-4):
        mx, my = (p[0] + q[0]) / 2 + dx, (p[1] + q[1]) / 2 + dy
        return (f'<line x1="{p[0]:.1f}" y1="{p[1]:.1f}" x2="{q[0]:.1f}" y2="{q[1]:.1f}" stroke="#FF8A3D" stroke-width="1.4"/>'
                f'<text x="{mx:.1f}" y="{my:.1f}" font-family="Inter" font-weight="700" font-size="9" fill="#FFE1A6" text-anchor="middle">{label}</text>')
    ear_l, ear_r = m.LEFT_EAR, m.RIGHT_EAR
    return f'''<svg xmlns="http://www.w3.org/2000/svg" viewBox="30 50 190 170" width="760" height="680">
  <rect x="30" y="50" width="190" height="170" fill="#0A0F1E"/>
  <path d="M70 148 Q120 78 172 142" fill="none" stroke="#F5B025" stroke-width="14" stroke-linecap="round"/>
  <rect x="{ear_l[0]}" y="{ear_l[1]}" width="{ear_l[2]}" height="{ear_l[3]}" rx="8" fill="#F5B025"/>
  <rect x="{ear_r[0]}" y="{ear_r[1]}" width="{ear_r[2]}" height="{ear_r[3]}" rx="10" fill="#F5B025"/>
  <polygon points="{pts}" fill="#6CB6FF" fill-opacity="0.22" stroke="#6CB6FF" stroke-opacity="0.35" stroke-width="{join + 2 * m.MIN_CLEAR}" stroke-linejoin="round"/>
  <polygon points="{pts}" fill="#F5B025" stroke="#F5B025" stroke-width="{join}" stroke-linejoin="round"/>
  {dim(pl, el, f"{l:.0f}".replace(".", ","), dy=-5)}{dim(pr, er, f"{r:.0f}", dy=-5)}{dim(pa, qa, f"{a:.0f}", dx=16, dy=0)}
  <line x1="{m.CMR_CX}" y1="62" x2="{m.CMR_CX}" y2="214" stroke="#FFFFFF" stroke-opacity="0.35" stroke-dasharray="3 3" stroke-width="0.8"/>
  <line x1="40" y1="{m.CMR_BOTTOM}" x2="210" y2="{m.CMR_BOTTOM}" stroke="#FFFFFF" stroke-opacity="0.35" stroke-dasharray="3 3" stroke-width="0.8"/>
  <text x="206" y="{m.CMR_BOTTOM + 11}" font-family="Inter" font-size="7.5" fill="#B7C0D4" text-anchor="end">bas des écouteurs (y = 194)</text>
  <text x="{m.CMR_CX + 3}" y="64" font-family="Inter" font-size="7.5" fill="#B7C0D4">axe (x = 117)</text>
  </svg>'''


def pixel_row():
    """Contour complet (70 points) et contour allégé (36 points) à 96, 48 et 32 px réels, agrandis 4x sans lissage."""
    from PIL import Image as PI
    cells = []
    for name, lab in (("castbridge-icon-512", "contour complet (70 points) - grand format"), ("castbridge-symbol", "contour allégé (36 points) - petites tailles")):
        row = []
        for px in (96, 48, 32):
            png = raster(os.path.join(BR, "logo", name + ".svg"), px)
            im = PI.open(png).convert("RGBA")
            big = im.resize((im.width * 4, im.height * 4), PI.NEAREST)
            out = os.path.join(TMP, f"px{name}{px}.png")
            canvas = PI.new("RGBA", (96 * 4, 96 * 4), (255, 255, 255, 255))
            canvas.paste(big, ((96 * 4 - big.width) // 2, (96 * 4 - big.height) // 2), big)
            canvas.save(out)
            row.append(Table([[pic(out, 24)], [P(f"{px} px", "cap")]], colWidths=[30 * mm], style=[("ALIGN", (0, 0), (-1, -1), "CENTER")]))
        cells.append([P(lab, "cellb")] + row)
    t = Table(cells, colWidths=[W - 3 * 32 * mm] + [32 * mm] * 3)
    t.setStyle(TableStyle([("VALIGN", (0, 0), (-1, -1), "MIDDLE"), ("LINEBELOW", (0, 0), (-1, -1), 0.3, LINE)]))
    return t


