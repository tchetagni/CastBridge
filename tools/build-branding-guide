def sem(key, mode="dark"):
    return C["semantic"][key][mode]["value"]


def icon_inner(name):
    t = open(os.path.join(BR, "icons", name + ".svg"), encoding="utf-8").read()
    inner = t.split(">", 1)[1].rsplit("</svg>", 1)[0]
    return '<g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' + inner + "</g>"


def badge_svg(level_key, icon, label, word, width=300):
    """Pastille d'état sur fond TV : anneau 3 dp de la couleur du niveau, icône, libellé + mot d'état ; le noir = fond noir + anneau clair + icône à 60 %."""
    off = level_key == "off"
    ring = sem("offRing") if off else sem(level_key)
    fill = sem("off") if off else hexv("dark.surface")
    ic = hexv("dark.textHigh")
    return f'''<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {width} 50" width="{width * 3}" height="150">
  <rect x="1.5" y="1.5" width="{width - 3}" height="47" rx="23.5" fill="{fill}" stroke="{ring}" stroke-width="3"/>
  <g transform="translate(14 11) scale(1.17)" color="{ic}" opacity="{0.6 if off else 1}">{icon_inner(icon).replace("currentColor", ic)}</g>
  <text x="50" y="31" font-family="Inter" font-size="15" fill="{hexv("dark.textHigh")}"><tspan font-weight="700">{label}</tspan> · {word}</text>
  <circle cx="{width - 20}" cy="25" r="6" fill="{ring}"/>
  </svg>'''


