                   f"Mobile : {g['mobileColumns']['value']} colonnes, gouttière et marge {g['mobileMargin']['value']}."))
    story.append(H2("Espacements (dp)"))

    class Bars(Flowable):
        def __init__(self):
            super().__init__()
            self.height = 20 * mm
            self.width = W

        def draw(self):
            c = self.canv
            x = 0
            for k, v in TOK["spacing"].items():
                n = int(re.match(r"\d+", v["value"]).group(0))
                if n == 0:
                    continue
                c.setFillColor(GOLD)
                c.rect(x, 5 * mm, n * 0.18 * mm if n < 40 else n * 0.1 * mm + 3 * mm, 8 * mm, stroke=0, fill=1)
                c.setFillColor(TXT2)
                c.setFont(BODY, 7)
                c.drawString(x, 1.5 * mm, str(n))
                x += (n * 0.18 * mm if n < 40 else n * 0.1 * mm + 3 * mm) + 3 * mm

    story.append(Bars())
    story.append(H2("Rayons (dp)"))

