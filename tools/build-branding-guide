def footer(canvas, doc):
    canvas.saveState()
    if doc.page > 1:
        canvas.setFillColor(TXT3)
        canvas.setFont(BODY, 7.5)
        canvas.drawString(18 * mm, 10 * mm, "CastBridge - Charte graphique v1.2")
        canvas.drawRightString(A4[0] - 18 * mm, 10 * mm, f"Page {doc.page}")
        canvas.setStrokeColor(LINE)
        canvas.line(18 * mm, 14 * mm, A4[0] - 18 * mm, 14 * mm)
    canvas.restoreState()


def main():
    out = os.path.join(BR, "guide", "CastBridge-charte-graphique.pdf")
    doc = BaseDocTemplate(out, pagesize=A4, leftMargin=18 * mm, rightMargin=18 * mm, topMargin=18 * mm, bottomMargin=18 * mm,
                          title="CastBridge - Charte graphique", author="CastBridge")
    frame = Frame(18 * mm, 18 * mm, W, A4[1] - 36 * mm, id="f", leftPadding=0, rightPadding=0, topPadding=0, bottomPadding=0)
    doc.addPageTemplates([PageTemplate(id="main", frames=[frame], onPage=footer)])
    for f in (cover, toc, brand, logos, construction, wordmark, colours, signals, typo, grid, focus, icons, ux, subs, android, screens, dos_donts, sources, files):
        f()
    doc.build(story)
    print("écrit", out)


