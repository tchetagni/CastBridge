def focus():
    story.append(H1("7. États de focus et animations"))
    f = TOK["focus"]["tv"]

    class FocusDemo(Flowable):
        def __init__(self):
            super().__init__()
            self.height = 42 * mm
            self.width = W

        def draw(self):
            c = self.canv
            c.setFillColor(INK)
            c.roundRect(0, 0, W, 42 * mm, 3 * mm, stroke=0, fill=1)
            for i, focused in enumerate((False, True, False)):
                x = 12 * mm + i * 55 * mm
                y = 9 * mm
                w, h = 44 * mm, 24 * mm
                if focused:
                    s = 1.04
                    x2, y2, w2, h2 = x - w * (s - 1) / 2, y - h * (s - 1) / 2, w * s, h * s
                    c.setStrokeColor(col(hexv("dark.focusRing")))
                    c.setLineWidth(1.4)
                    c.setFillColor(col(hexv("dark.surfaceHigh")))
                    c.roundRect(x2, y2, w2, h2, 3 * mm, stroke=1, fill=1)
                else:
                    c.setFillColor(SURF)
                    c.roundRect(x, y, w, h, 3 * mm, stroke=0, fill=1)
                c.setFillColor(col(hexv("dark.textHigh")))
                c.setFont(BODY_B, 8)
                c.drawCentredString(x + w / 2, y + h / 2 - 1, "Focalisé" if focused else "Repos")

    story.append(FocusDemo())
    story.append(Spacer(1, 3 * mm))
    story.append(P(f"<font name='{BODY_B}'>Focus TV (critique à la télécommande)</font> : anneau {f['ringColor']['value']} de {f['ringWidth']['value']}, décalage {f['ringOffset']['value']}, "
