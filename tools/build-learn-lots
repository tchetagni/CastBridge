#!/bin/sh
# Builds the « Apprendre » lots (docs/LEARN.md § Lots): ONE zip per class (content/learn/scopes.txt) + lots-catalog.json
# (the LotMeta list, feature=learn, ready for the server's lots publish endpoint) + the size report.
#
#   tools/build-learn-lots [out dir]     check that content/learn/lots.json matches the content, build the lots
#   tools/build-learn-lots --update      bump the version (and date) of every lot whose content changed, rewrite lots.json, build
#   tools/build-learn-lots --review      regenerate docs/LEARN-REVIEW.md (what the teachers must check, per lot)
#
# Fails when a lot exceeds 3 MB, when a pack has no lot, or when a lot changed without --update. Needs Gradle 8.14+ and a JDK 17+
# (no wrapper in the repository); ANDROID_HOME is not needed for these tasks of :core.
set -e
ROOT=$(cd "$(dirname "$0")/.." && pwd)
GRADLE=${GRADLE:-gradle}
OUT_BUILT="$ROOT/android/core/build/learn-lots"
case "$1" in
  --review) exec "$GRADLE" -q -p "$ROOT/android" :core:reviewLearn ;;
  --update) "$GRADLE" -q -p "$ROOT/android" :core:buildLearnLots -Pupdate; shift ;;
  *) "$GRADLE" -q -p "$ROOT/android" :core:buildLearnLots ;;
esac
if [ -n "$1" ]; then
  mkdir -p "$1"
  cp "$OUT_BUILT"/*.lot.zip "$OUT_BUILT"/lots-catalog.json "$1"/
  echo "Lots copiés dans $1"
else
  echo "Lots dans $OUT_BUILT"
fi
