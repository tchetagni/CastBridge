# Copy to .env (never committed), fill in, then: chmod 600 .env
# Random values: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# --- MySQL (internal network only) ---
CASTBRIDGE_DB_PASSWORD=
CASTBRIDGE_DB_ROOT_PASSWORD=

# --- Admin API (Bearer token, at least 32 characters; used by curl / the release CI) ---
CASTBRIDGE_ADMIN_TOKEN=

# --- Admin web interface (/admin): initial account, created at the first start ---
CASTBRIDGE_WEB_ADMIN_USER=esaie
# at least 12 characters; only read to create the account (or to reset it, see below)
CASTBRIDGE_WEB_ADMIN_PASSWORD=
# true = overwrite the stored password with the one above at the next start (forgotten password), then set back to false
CASTBRIDGE_WEB_ADMIN_RESET_PASSWORD=false
# the session cookie is "Secure" (HTTPS only; http://localhost also works in browsers). false only for plain-HTTP tests.
CASTBRIDGE_COOKIE_SECURE=true

# --- Update manifests: Ed25519 private key file (PEM), see README "Clés Ed25519" ---
CASTBRIDGE_SIGNING_KEY_PATH=./secrets/castbridge-signing.pem

# --- Public address (download links in the manifests). Examples:
#   https://castbridge.example.org           (sub-domain)
#   https://example.org/castbridge           (path behind the shared nginx)
CASTBRIDGE_PUBLIC_BASE_URL=

# --- Host port, bound on 127.0.0.1 only (nginx proxies to it) ---
CASTBRIDGE_PORT=7090

# --- Approximate location of devices (optional) ---
# header set by the proxy/CDN with the ISO country code (e.g. CF-IPCountry behind Cloudflare), or empty
CASTBRIDGE_GEO_COUNTRY_HEADER=
# MaxMind GeoLite2 City/Country database mounted from CASTBRIDGE_GEOIP_DIR (default ./geoip), e.g. /geoip/GeoLite2-City.mmdb
CASTBRIDGE_GEOIP_DIR=./geoip
CASTBRIDGE_GEOIP_DB=

# --- Per-IP limit on the public routes ---
CASTBRIDGE_RATE_LIMIT_PER_MINUTE=120
CASTBRIDGE_RATE_LIMIT_BURST=60

# --- Import the question bank bundled in the TV app when the bank is empty ---
CASTBRIDGE_QUIZ_SEED=true

# --- backup.sh ---
CASTBRIDGE_BACKUP_DIR=/var/backups/castbridge
CASTBRIDGE_BACKUP_RETENTION_DAYS=14

# --- deploy.sh: default git ref to deploy ---
DEPLOY_REF=origin/main
